{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bisellium context --studio studio",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bisellium hook-event sync --studio studio",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.tool_input.run_in_background != true and (.tool_input.command // \"\" | gsub(\"\\\"(\\\\\\\\.|[^\\\"\\\\\\\\])*\\\"|\\\\x27[^\\\\x27]*\\\\x27\"; \"Q\") | test(\"(^|\\\\s)&(?![&>])|(?<![&>|<\\\\\\\\])&(?=\\\\s|$|[;)}])|(^|[^-\\\\w./])(nohup|setsid|disown)(?![-\\\\w.])\"))' >/dev/null 2>&1 && { echo 'Blocked: &, nohup, setsid and disown die when this Bash call returns. Run the long command as its own Bash call with the run_in_background parameter set to true instead.' >&2; exit 2; }; exit 0",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bisellium hook-event guard --studio studio",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -e \"$CLAUDE_PROJECT_DIR/.git/bisellium/sync\" || bisellium hook-event sync --studio studio",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bisellium hook-event guard --studio studio",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Workflow"
    ]
  }
}
