{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bisellium context --studio studio",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bisellium hook-event sync --studio studio",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bisellium hook-event guard --studio studio",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bisellium hook-event guard --studio studio",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -e \"$CLAUDE_PROJECT_DIR/.git/bisellium/sync\" || bisellium hook-event sync --studio studio",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bisellium hook-event guard --studio studio",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bisellium hook-event guard --studio studio",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Workflow"
    ]
  }
}
