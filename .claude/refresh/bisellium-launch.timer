# W-543: tries a launch every 30 minutes all day (SGT, UTC+8; Patron 11-16); each try refuses unless a newer
# handoff landed and nothing runs. A try while the service still runs is skipped by systemd.
[Unit]
Description=bisellium launch, every 30 minutes, all day (W-543; Patron 11-16)

[Timer]
OnCalendar=*-*-* *:00,30:00 Asia/Singapore
Persistent=false

[Install]
WantedBy=timers.target
