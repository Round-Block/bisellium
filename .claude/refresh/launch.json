{
  "allow": [
    "Agent",
    "Bash",
    "Read",
    "Glob",
    "Grep",
    "TaskStop",
    "SubagentHandback",
    "SendMessage",
    "PushNotification",
    "ToolSearch",
    "Edit({agent}/**)",
    "Write({agent}/**)",
    "Edit({evidence}/**)",
    "Write({evidence}/**)",
    "Edit(//tmp/claude-*/**)",
    "Write(//tmp/claude-*/**)"
  ],
  "disallow": [
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(git push --force-with-lease:*)",
    "Bash(gh pr close:*)",
    "Bash(git stash drop:*)",
    "Bash(git worktree prune:*)",
    "Bash(claude:*)",
    "Bash(bash scripts/cascade-loop.sh:*)",
    "Bash(scripts/cascade-loop.sh:*)",
    "Edit({agent}/.claude/**)",
    "Write({agent}/.claude/**)",
    "Edit(~/projects/**)",
    "Write(~/projects/**)"
  ],
  "addDirs": ["~/.bisellium-evidence"],
  "cap": { "starts": 4, "hours": 12 }
}
