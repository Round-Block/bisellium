+          end = Math.min(o.lines.length, l.endLine + req.adjacentLines!);
+        } else {
+          let at = -1;
+          for (let n = Math.min(l.startLine - 1, o.lines.length - 1); n >= 0; n--)
+            if (o.levels[n] !== null) {
+              at = n;
+              break;
+            }
+          if (at < 0) {
+            error(result, l.repository, l.path, "UNRESOLVED");
+            continue;
+          }
+          start = at + 1;
+          end = o.lines.length;
+          const level = o.levels[at]!;
+          for (let n = at + 1; n < o.lines.length; n++) {
+            const x = o.levels[n];
+            if (typeof x === "number" && x <= level) {
+              end = n;
+              break;
+            }
+          }
+        }
+        const where = { repository: l.repository, path: l.path, startLine: start, endLine: end },
+          section = body(o, where, chars, result);
+        if (section) result.items.push(mkitem(repo, l.path, o, start, section.end, null, section.text));
+      } catch (e) {
+        error(result, l.repository, l.path, ecode(e));
+      }
+    }
+    return finish(result, run);
+  } catch (e) {
+    return refuse(e instanceof Refusal ? e.code : "IO");
+  }
+}
+export async function runSourceCommand(argv: string[]): Promise<{ exitCode: number }> {
+  let rp: string | undefined, qp: string | undefined;
+  try {
+    for (let n = 0; n < argv.length; n++) {
+      const k = argv[n],
+        v = argv[++n];
+      if ((k !== "--registry" && k !== "--request") || v === undefined || (k === "--registry" ? rp : qp) !== undefined)
+        throw new Refusal("INVALID_INPUT");
+      if (k === "--registry") rp = v;
+      else qp = v;
+    }
+    if (!rp || !qp) throw new Refusal("INVALID_INPUT");
+    const out = await runSource(control(rp, 262144), control(qp, 16384));
+    console.log(JSON.stringify(out));
+    return { exitCode: "error" in out ? 2 : out.ok ? 0 : 1 };
+  } catch (e) {
+    console.log(JSON.stringify(refuse(e instanceof Refusal ? e.code : "INVALID_INPUT")));
+    return { exitCode: 2 };
+  }
+}
