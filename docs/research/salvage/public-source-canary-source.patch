+  if (only !== 0 && only !== b) return;
+  console.log(`${ok ? "PASS" : "FAIL"}  b${b} ${name.padEnd(78)} ${detail}`);
+  if (!ok) failed++;
+}
+function runs(b: number): boolean {
+  return only === 0 || only === b;
+}
