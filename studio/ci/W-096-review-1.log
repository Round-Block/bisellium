   496	    console.error(`exactly one of --pass/--fail is required\n${REVIEW_USAGE}`);
   497	    return { exitCode: 2 };
   498	  }
   499	
   500	  const evidence = values.get("--evidence");
   501	  if (!evidence) {
   502	    console.error(REVIEW_USAGE);
   503	    return { exitCode: 2 };
   504	  }
   505	
   506	  let round: number | undefined;
