   277	const INVALID_RED_OUTPUT =
   278	  /ERR_MODULE_NOT_FOUND|SyntaxError:|command not found|ENOENT|unknown (?:option|flag)|not permitted|permission denied|operation not permitted|sandbox/i;
   279	
   280	/** W-096's seven reds are selectable completed TAP assertion failures. */
   281	export function isW096AssertionRed(text: string, behaviour: number): boolean {
   282	  const header = parseLogHeader(text);
   283	  const command = header.get("command") ?? "";
   284	  const selected = new RegExp(`(?:^|\\s)--behaviour\\s+${behaviour}(?:\\s|$)`).test(command);
   285	  const name = `W-096 behaviour ${behaviour}:`;
   286	  const body = stripHeader(text);
   287	  const exit = header.get("exit") ?? "";
   288	  if (header.get("behaviour") !== String(behaviour) || !/^-?\d+$/.test(exit) || exit === "0" || !selected || INVALID_RED_OUTPUT.test(body)) return false;
   289	  if (!/^TAP version 13$/m.test(body)) return false;
   290	  const statuses = [...body.matchAll(/^(?:not )?ok \d+ - (.+)$/gm)];
   291	  if (statuses.length !== 1 || !statuses[0]![0].startsWith("not ok ") || !statuses[0]![1]!.startsWith(name)) return false;
   292	  const diagnosticStart = body.indexOf("\n  ---\n", statuses[0]!.index);
   293	  const diagnosticEnd = diagnosticStart < 0 ? -1 : body.indexOf("\n  ...", diagnosticStart + 7);
   294	  if (diagnosticStart < 0 || diagnosticEnd < 0 || !/^\s*code: ['"]ERR_ASSERTION['"]\s*$/m.test(body.slice(diagnosticStart, diagnosticEnd))) return false;
   295	  const plan = /^1\.\.(\d+)\s*$/m.exec(body);
   296	  const tests = /^# tests (\d+)\s*$/m.exec(body);
   297	  const failed = /^# fail (\d+)\s*$/m.exec(body);
   298	  const passed = /^# pass (\d+)\s*$/m.exec(body);
   299	  return plan?.[1] === "1" && tests?.[1] === "1" && failed?.[1] === "1" && (passed?.[1] ?? "0") === "0" && !/^ok \d+ -/m.test(body);
   300	}
