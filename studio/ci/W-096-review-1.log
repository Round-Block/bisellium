   521	function authoritativeUiInput(root: string, record: NativeRecord, expectedDigest: string): { input?: UiInput; problems: string[] } {
   522	  const id = typeof record.id === "string" ? record.id : "";
   523	  const candidates: { relative: string; round: number }[] = [];
   524	  let names: string[] = [];
   525	  try {
   526	    names = readdirSync(join(root, "ci"));
   527	  } catch {
   528	    return { problems: ["ci/ is unreadable; no ui-lead input can be established"] };
   529	  }
   530	  const pattern = new RegExp(`^${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}-spec-([1-9][0-9]*)\\.log$`);
   531	  for (const name of names) {
   532	    const match = pattern.exec(name);
   533	    if (!match) continue;
   534	    candidates.push({ relative: `ci/${name}`, round: Number(match[1]) });
   535	  }
   536	  if (candidates.length === 0) return { problems: ["no ui-lead spec input exists"] };
   537	  candidates.sort((a, b) => b.round - a.round);
   538	  const latest = candidates[0]!;
   539	  const file = readContainedRegularFile(root, latest.relative, "ci");
   540	  if ("error" in file) return { problems: [`latest UI spec round is unsafe or unreadable: ${file.error}`] };
   541	  const h = parseVerdictHeader(file.bytes.toString("utf8"));
   542	  const problems: string[] = [];
   543	  if (h.duplicates.length) problems.push(`duplicate verdict header key(s): ${h.duplicates.join(", ")}`);
   544	  if (h.values.get("opus") !== id || h.values.get("phase") !== "spec" || h.values.get("round") !== String(latest.round) || h.values.get("sella") !== "ui-lead")
   545	    problems.push("latest ui-lead verdict header does not match its opus, phase, round and sella");
   546	  const outcome = h.values.get("outcome") ?? "";
   547	  const at = h.values.get("at") ?? "";
   548	  if (utcTimestampProblem(at)) problems.push("latest ui-lead verdict has an invalid timestamp");
   549	  const digest = h.values.get("design_digest") ?? "";
   550	  if (!DIGEST.test(digest) || digest !== expectedDigest) problems.push("latest ui-lead verdict has a missing, malformed or stale design_digest");
   551	  const promptRel = h.values.get("dispatch_prompt");
   552	  if (!promptRel) problems.push("latest ui-lead verdict has no dispatch_prompt header");
   553	  let prompt = "";
   554	  if (promptRel) {
   555	    const file = readContainedRegularFile(root, promptRel, "ci");
   556	    if ("error" in file) problems.push(`dispatch prompt is unsafe or unreadable: ${file.error}`);
   557	    else prompt = file.bytes.toString("utf8");
   558	  }
   559	  if (promptRel && prompt !== "") problems.push(...substantiveUiTranscript(h.body, outcome, prompt));
   560	  if (problems.length) return { problems };
   561	  return { input: { relative: latest.relative, header: h, round: latest.round, at, digest }, problems };
   562	}
