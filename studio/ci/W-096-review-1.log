   100	/** Dates must be ISO strings (or YAML-parsed Date objects); anything else is rejected, not guessed. */
   101	function isoDate(v: unknown): Date | undefined {
   102	  if (v instanceof Date) return Number.isNaN(v.getTime()) ? undefined : v;
   103	  if (typeof v !== "string" || !ISO.test(v)) return undefined;
   104	  const d = new Date(v);
   105	  return Number.isNaN(d.getTime()) ? undefined : d;
   106	}
   107	
   108	function safeYaml(path: string): { data: Dict | undefined; error?: string } {
   109	  try {
   110	    const text = readFileSync(path, "utf8").replace(/^﻿/, "");
   111	    const v = parseYaml(text);
   112	    if (v === null || v === undefined) return { data: undefined, error: "empty file" };
   113	    if (!isDict(v)) return { data: undefined, error: "top level is not a mapping" };
   114	    return { data: v };
   115	  } catch (e) {
   116	    return { data: undefined, error: (e as Error).message };
   117	  }
   118	}
   119	
   120	function safeFront(path: string): { data?: Dict; body: string; raw: string; error?: string } {
   121	  try {
   122	    const fm = readFront<unknown>(path);
   123	    if (!isDict(fm.data)) return { body: fm.body, raw: fm.raw, error: "front matter is not a mapping" };
   124	    return { data: fm.data, body: fm.body, raw: fm.raw };
   125	  } catch (e) {
   126	    return { body: "", raw: "", error: (e as Error).message };
   127	  }
   128	}
