    90	type Dict = Record<string, unknown>;
    91	const isDict = (v: unknown): v is Dict => typeof v === "object" && v !== null && !Array.isArray(v);
    92	const str = (v: unknown): string | undefined => (typeof v === "string" && v.length > 0 ? v : undefined);
    93	const num = (v: unknown): number | undefined => (typeof v === "number" && Number.isFinite(v) ? v : undefined);
    94	/** Signed elapsed days from `a` to `b`, clamped at 0 — a future `a` (relative
    95	 *  to `b`) reads as fresh (0 days old), never as stale via an absolute value. */
    96	const days = (a: Date, b: Date): number => Math.max(0, (b.getTime() - a.getTime()) / 86_400_000);
    97	/** Same clamp as `days`, in minutes — receipts are checked on a minutes timescale, not days. */
    98	const minutes = (a: Date, b: Date): number => Math.max(0, (b.getTime() - a.getTime()) / 60_000);
