   579	function validateServed(root: string, record: NativeRecord): { at?: string; tree?: string; problems: string[] } {
   580	  const gates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes) ? (record.probationes as Record<string, unknown>) : {};
   581	  const value = gates["served-e2e"];
   582	  if (typeof value !== "object" || value === null || Array.isArray(value)) return { problems: ["served-e2e has no recorded result"] };
   583	  const gate = value as Record<string, unknown>;
   584	  const problems: string[] = [];
   585	  if (gate["status"] !== "passed") problems.push("served-e2e must be passed and cannot be waived");
   586	  const certifies = typeof gate["certifies"] === "string" ? gate["certifies"] : undefined;
   587	  if (!certifies || !TREE_CERTIFICATE.test(certifies)) problems.push("served-e2e needs a clean tree certificate");
   588	  const at = typeof gate["at"] === "string" ? gate["at"] : undefined;
   589	  if (!at || utcTimestampProblem(at)) problems.push("served-e2e needs an exact run timestamp");
   590	  const evidence = typeof gate["evidence"] === "string" ? gate["evidence"] : undefined;
   591	  if (!evidence) problems.push("served-e2e needs an evidence log");
   592	  else {
   593	    const log = readContainedRegularFile(root, evidence, "ci");
   594	    if ("error" in log) problems.push(`served-e2e evidence is unsafe or unreadable: ${log.error}`);
   595	    else {
   596	      const text = log.bytes.toString("utf8");
   597	      if (!certifies || !text.includes(`certifies: ${certifies}`)) problems.push("served-e2e evidence does not corroborate its certificate");
   598	      if (!text.includes("command: node scripts/served-e2e.mjs")) problems.push("served-e2e evidence does not corroborate the reserved command");
   599	      if (!/^exit code: 0\s*$/m.test(text)) problems.push("served-e2e evidence does not record a successful run");
   600	    }
   601	  }
   602	  return { at, tree: certifies, problems };
