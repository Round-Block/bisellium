   105	// ---------------------------------------------------------------------------
   106	// Seam S1 — runNew: self-parsing `bisellium new`
   107	// ---------------------------------------------------------------------------
   108	
   109	const NEW_USAGE =
   110	  "usage: bisellium new --kind <kind> --collegium <collegium> --title <title> [--arc <id>] [--parent <id>] [--spec <path>] [--brief] [dir]";
   111	
   112	const BRIEF_SECTIONS = ["Intent", "Files owned", "Interfaces", "Behaviours to test", "Acceptance", "Out of scope"];
   113	
   114	function briefTemplate(id: string, title: string): string {
   115	  const sections = BRIEF_SECTIONS.map((s) => `## ${s}\n\nTODO.\n`).join("\n");
   116	  return `# ${id} — ${title}\n\n${sections}`;
   117	}
   118	
   119	/** `--spec <path>` must be an officina-relative path with no leading `/`
   120	 *  and no `..` segment, and must resolve inside the officina — never an
   121	 *  absolute path, never something that escapes it via `..`. */
   122	function validSpecPath(root: string, specPath: string): boolean {
   123	  if (isAbsolute(specPath)) return false;
   124	  if (specPath.split(/[\\/]+/).includes("..")) return false;
   125	  const rel = relative(root, resolve(root, specPath));
   126	  return rel !== "" && !rel.startsWith("..") && !isAbsolute(rel);
   127	}
   128	
   129	/** Minimal, strict self-contained argv parser (Seam S1): every command this
   130	 *  cascade touches parses its own argv, dispatched in main.ts before the
   131	 *  generic flag parser — the discipline that makes `--brief` (a bare
   132	 *  boolean) and `--spec` work at all without one swallowing the other's
   133	 *  value. Splits on the FIRST `=` only, same as main.ts's own parser, so a
   134	 *  value may itself contain `=` (`--title='a=b: ship it'`). */
   135	function parseNewArgs(args: string[]): { values: Map<string, string>; brief: boolean; positionals: string[] } | { error: string } {
   136	  const values = new Map<string, string>();
   137	  let brief = false;
   138	  const positionals: string[] = [];
   139	  const valuedFlags = new Set(["--kind", "--collegium", "--title", "--arc", "--parent", "--spec"]);
   140	
   141	  for (let i = 0; i < args.length; i++) {
   142	    const a = args[i]!;
   143	    if (!a.startsWith("--")) { positionals.push(a); continue; }
   144	    const eq = a.indexOf("=");
   145	    const k = eq === -1 ? a : a.slice(0, eq);
   146	    const inline = eq === -1 ? undefined : a.slice(eq + 1);
   147	    if (k === "--brief") {
   148	      if (inline === undefined || inline === "true") { brief = true; continue; }
   149	      if (inline === "false") { brief = false; continue; }
   150	      return { error: `${k} must be true or false` };
   151	    }
   152	    if (!valuedFlags.has(k)) return { error: `flag ${k} not allowed for "new"\n${NEW_USAGE}` };
   153	    const v = inline ?? args[++i];
   154	    if (v === undefined) return { error: `${k} needs a value\n${NEW_USAGE}` };
   155	    values.set(k, v);
   156	  }
   157	  return { values, brief, positionals };
   158	}
   159	
   160	export function runNew(args: string[]): { exitCode: number } {
   161	  const parsed = parseNewArgs(args);
   162	  if ("error" in parsed) { console.error(parsed.error); return { exitCode: 2 }; }
   163	  const { values, brief, positionals } = parsed;
   164	
   165	  const kind = values.get("--kind");
   166	  const collegium = values.get("--collegium");
   167	  const title = values.get("--title");
   168	  if (!kind || !collegium || !title) { console.error(NEW_USAGE); return { exitCode: 2 }; }
   169	
   170	  const root = resolve(positionals[0] ?? ".");
   171	  const manifestPath = join(root, "bisellium.yml");
   172	  if (!existsSync(manifestPath)) { console.error(`${manifestPath} not found — not a studio`); return { exitCode: 2 }; }
   173	
   174	  let manifest: Manifest;
   175	  try {
   176	    manifest = parseYaml(readFileSync(manifestPath, "utf8")) as Manifest;
   177	  } catch (e) {
   178	    console.error(`${manifestPath} unparseable — not a studio: ${(e as Error).message}`);
   179	    return { exitCode: 2 };
   180	  }
   181	
   182	  const specOpt = values.get("--spec");
   183	  if (specOpt !== undefined && !brief && !validSpecPath(root, specOpt)) {
   184	    // Refused before anything is written: absolute, a `..` segment, or
   185	    // resolves outside the officina.
   186	    console.error(`--spec "${specOpt}" must be an officina-relative path with no ".." segment, inside the studio`);
   187	    return { exitCode: 1 };
   188	  }
   189	  try {
   190	    const collegia = manifest.collegia ?? [];
   191	    if (!collegia.some((d) => d.id === collegium)) {
   192	      console.error(`collegium "${collegium}" is not declared in ${manifestPath}`);
   193	      return { exitCode: 1 };
   194	    }
   195	    if (!isNativeOpusKind(kind)) {
   196	      console.error(`kind ${JSON.stringify(kind)} is not a native opus kind`);
   197	      return { exitCode: 1 };
   198	    }
   199	    const badTitle = titleProblem(title);
   200	    if (badTitle) {
   201	      console.error(badTitle);
   202	      return { exitCode: 1 };
   203	    }
   204	    const loaded = loadNativeRecords(root);
   205	    if (loaded.problems.length) {
   206	      console.error(loaded.problems[0]!.problem.message);
   207	      return { exitCode: 1 };
   208	    }
   209	    const proposed = {
   210	      id: "W-0",
   211	      title,
   212	      kind,
   213	      collegium,
   214	      state: "backlog",
   215	      arc: values.get("--arc"),
   216	      parent: values.get("--parent"),
   217	    };
   218	    const modelProblem = validateNativeRecord(proposed, loaded.records)[0];
   219	    if (modelProblem) {
   220	      console.error(`${modelProblem.rule}: ${modelProblem.message}`);
   221	      return { exitCode: 1 };
   222	    }
   223	
   224	    const created = createNextRecord(root, "opera", "W", (id) => {
   225	      const candidateProblem = validateNativeRecord({ ...proposed, id }, loaded.records)[0];
   226	      if (candidateProblem) throw new Error(`${candidateProblem.rule}: ${candidateProblem.message}`);
   227	      // --brief always wins over an explicit --spec: it creates the canonical
   228	      // briefs/<id>.md and points spec: at exactly that path, so the two
   229	      // never disagree.
   230	      const briefRelPath = `briefs/${id}.md`;
   231	      const specValue = brief ? briefRelPath : specOpt;
   232	      const front = `---
   233	id: ${JSON.stringify(id)}
   234	title: ${JSON.stringify(title)}
   235	kind: ${JSON.stringify(kind)}
   236	collegium: ${JSON.stringify(collegium)}
   237	state: backlog${specValue !== undefined ? `\nspec: ${JSON.stringify(specValue)}` : ""}
   238	${values.get("--arc") === undefined ? "" : `arc: ${JSON.stringify(values.get("--arc"))}\n`}${values.get("--parent") === undefined ? "" : `parent: ${JSON.stringify(values.get("--parent"))}\n`}probationes: {}
   239	---
   240	`;
   241	      waitAtIdsTestBarrier(id);
   242	      return front;
   243	    });
   244	    if (brief) {
   245	      const briefsDir = join(root, "briefs");
   246	      mkdirSync(briefsDir, { recursive: true });
   247	      try {
   248	        writeFileSync(join(briefsDir, `${created.id}.md`), briefTemplate(created.id, title), { flag: "wx" });
   249	      } catch (error) {
   250	        unlinkSync(created.path);
   251	        throw error;
   252	      }
   253	    }
   254	    console.log(created.id);
   255	    return { exitCode: 0 };
   256	  } catch (e) {
   257	    console.error(`new failed: ${(e as Error).message}`);
   258	    return { exitCode: 1 };
   259	  }
   260	}
