    73	/** Frozen W-096 set, deliberately independent of the runtime's Unicode data. */
    74	export function titleProblem(value: unknown): string | undefined {
    75	  if (typeof value !== "string" || value.trim() === "") return "title must be a nonblank string";
    76	  for (const char of value) {
    77	    const cp = char.codePointAt(0)!;
    78	    if (
    79	      cp <= 0x1f ||
    80	      (cp >= 0x7f && cp <= 0x9f) ||
    81	      cp === 0x2028 ||
    82	      cp === 0x2029 ||
    83	      cp === 0x00ad ||
    84	      (cp >= 0x0600 && cp <= 0x0605) ||
    85	      cp === 0x061c ||
    86	      cp === 0x06dd ||
    87	      cp === 0x070f ||
    88	      (cp >= 0x0890 && cp <= 0x0891) ||
    89	      cp === 0x08e2 ||
    90	      cp === 0x180e ||
    91	      (cp >= 0x200b && cp <= 0x200f) ||
    92	      (cp >= 0x202a && cp <= 0x202e) ||
    93	      (cp >= 0x2060 && cp <= 0x2064) ||
    94	      (cp >= 0x2066 && cp <= 0x206f) ||
    95	      cp === 0xfeff ||
    96	      (cp >= 0xfff9 && cp <= 0xfffb) ||
    97	      cp === 0x110bd ||
    98	      cp === 0x110cd ||
    99	      (cp >= 0x13430 && cp <= 0x1343f) ||
   100	      (cp >= 0x1bca0 && cp <= 0x1bca3) ||
