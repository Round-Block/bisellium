   605	function reviewCitation(root: string, record: NativeRecord, input: UiInput, expectedDigest: string, reviewId: string): string[] {
   606	  const gates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes) ? (record.probationes as Record<string, unknown>) : {};
   607	  const review = gates[reviewId];
   608	  if (typeof review !== "object" || review === null || Array.isArray(review)) return ["passed UI review evidence is missing"];
   609	  const gate = review as Record<string, unknown>;
   610	  if (gate["status"] !== "passed") return ["UI completion needs the sole review gate passed"];
   611	  const evidence = typeof gate["evidence"] === "string" ? gate["evidence"] : "";
   612	  const file = readContainedRegularFile(root, evidence, "ci");
   613	  if ("error" in file) return [`review evidence is unsafe or unreadable: ${file.error}`];
   614	  const header = parseVerdictHeader(file.bytes.toString("utf8"));
   615	  const problems: string[] = [];
   616	  if (header.duplicates.length) problems.push("review evidence contains duplicate header keys");
   617	  if (header.values.get("ui_input") !== input.relative) problems.push("review evidence does not cite the current ui-lead input");
   618	  if (header.values.get("design_digest") !== expectedDigest) problems.push("review evidence design_digest is missing or stale");
   619	  const sections = contentLines(header.body);
   620	  const dispositionHeads = sections.headings.filter((heading) => heading.level === 2 && heading.name === "UI input disposition");
   621	  const disposition = sections.lines.filter((line) => line.section === "UI input disposition");
   622	  if (dispositionHeads.length !== 1 || disposition.length === 0) problems.push("review evidence needs one nonblank ## UI input disposition section");
   623	  return problems;
   624	}
