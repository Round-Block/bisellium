   660	export function validateUiPolicy(context: UiPolicyContext): OpusModelProblem[] {
   661	  const { root, record, manifest, phase } = context;
   662	  if (record.kind !== "ui") return [];
   663	  const problems: OpusModelProblem[] = [];
   664	  const state = typeof record.state === "string" ? record.state : "";
   665	  const needsInput = phase === "ready" || phase === "done" || ["building", "verifying", "review", "done"].includes(state) || (state === "halted" && record.start !== undefined);
   666	  const id = typeof record.id === "string" ? record.id : "";
   667	  let hasInputCandidate = false;
   668	  try {
   669	    const pattern = new RegExp(`^${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}-spec-[1-9][0-9]*\\.log$`);
   670	    hasInputCandidate = readdirSync(join(root, "ci")).some((name) => pattern.test(name));
   671	  } catch { /* an early-state record does not require ci/ to exist */ }
   672	  const recordedGates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes)
   673	    ? (record.probationes as Record<string, unknown>)
   674	    : {};
   675	  const reviewId = typeof manifest.review_probatio === "string" && manifest.review_probatio.length > 0 ? manifest.review_probatio : "review";
   676	  const reviewGate = typeof recordedGates[reviewId] === "object" && recordedGates[reviewId] !== null && !Array.isArray(recordedGates[reviewId])
   677	    ? (recordedGates[reviewId] as Record<string, unknown>)
   678	    : {};
   679	  const validateDesign = needsInput || hasInputCandidate || record.ui_rulings !== undefined || reviewGate["status"] === "passed";
   680	  const needsRoute = needsInput || hasInputCandidate;
   681	  const uiSeat = manifest.sellae.find((seat) => seat.id === "ui-lead");
   682	  if (needsRoute && (!uiSeat || uiSeat.retired === true || uiSeat.collegium !== "design"))
   683	    problems.push({ rule: "opus.ui.route", message: "ui-lead must be a live design-collegium seat" });
   684	  problems.push(...effectiveProbationes("ui", manifest.probationes).problems);
   685	  const design = validateDesign ? currentDesign(root, record) : {};
   686	  let input: ReturnType<typeof authoritativeUiInput> = { problems: [] };
   687	  if (validateDesign && !design.digest) {
   688	    problems.push({ rule: "opus.ui.design", message: design.error ?? "current design could not be read" });
   689	  } else if (design.digest) input = authoritativeUiInput(root, record, design.digest);
   690	  const addPolicyProblem = (rule: "opus.ui.design" | "opus.ui.e2e" | "opus.ui.rulings", message: string): void => {
   691	    if (/unsafe|unreadable|symlink|regular file/i.test(message)) problems.push({ rule: "opus.reference", message });
   692	    problems.push({ rule, message });
   693	  };
   694	  if (needsInput || input.input || input.problems.some((problem) => !problem.startsWith("no ui-lead")))
   695	    for (const message of input.problems) addPolicyProblem("opus.ui.design", message);
   696	  const served = validateServed(root, record);
   697	  const needsServed = phase === "done" || state === "review" || state === "done";
   698	  if (needsServed) for (const message of served.problems) addPolicyProblem("opus.ui.e2e", message);
   699	  if ((phase === "done" || state === "done" || reviewGate["status"] === "passed") && input.input && design.digest)
   700	    for (const message of reviewCitation(root, record, input.input, design.digest, reviewId)) addPolicyProblem("opus.ui.design", message);
   701	
   702	  const refs = record.ui_rulings;
   703	  if (refs !== undefined && (!Array.isArray(refs) || refs.length === 0 || refs.some((value) => typeof value !== "string") || new Set(refs as unknown[]).size !== refs.length))
   704	    problems.push({ rule: "opus.ui.rulings", message: "ui_rulings must be a sequence of distinct decision-id strings" });
   705	  const ids = Array.isArray(refs) && refs.every((value) => typeof value === "string") ? (refs as string[]) : [];
   706	  let current = false;
   707	  let valid = 0;
   708	  if (design.digest) {
   709	    for (const id of ids) {
   710	      const result = ruling(root, record, id, design.digest, input.input?.at, served.at, served.tree);
   711	      if (!result.valid) addPolicyProblem("opus.ui.rulings", result.problem!);
   712	      else {
   713	        valid++;
   714	        if (result.current) current = true;
   715	      }
   716	    }
   717	  } else {
   718	    for (const id of ids) if (!DECISION_ID.test(id)) problems.push({ rule: "opus.ui.rulings", message: `${id} is not a decision id` });
   719	  }
   720	  if (phase === "done" || state === "done") {
   721	    if (ids.length === 0) problems.push({ rule: "opus.ui.rulings", message: "UI completion requires at least one Patron ruling" });
   722	    else if (!current) problems.push({ rule: "opus.ui.rulings", message: "no Patron ruling matches the current served tree and design digest at a sufficiently recent time" });
   723	  } else if (valid > 0 && !current) {
   724	    problems.push({ rule: "opus.ui.rulings", level: "advise", message: "supplied UI rulings are stale for the current design or served tree" });
   725	  }
   726	  return problems;
   727	}
