   493	export function validateRecordReferences(root: string, record: NativeRecord): OpusModelProblem[] {
   494	  // A non-UI done opus is historical: no lifecycle policy reads its current
   495	  // brief again, just as the legacy active-spec rule does not revisit it.
   496	  // UI is different because done policy recomputes the design digest from
   497	  // the current brief, so that reference remains live and must stay bounded.
   498	  if (record.state === "done" && record.kind !== "ui") return [];
   499	  if (record.spec === undefined) return [];
   500	  if (typeof record.spec !== "string") return [{ rule: "opus.reference", message: "spec must be a contained brief path" }];
   501	  const brief = readContainedRegularFile(root, record.spec, "briefs");
   502	  return "error" in brief ? [{ rule: "opus.reference", message: `spec is unsafe or unreadable: ${brief.error}` }] : [];
   503	}
