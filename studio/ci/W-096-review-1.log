   483	    console.error(`${parsed.error}\n${REVIEW_USAGE}`);
   484	    return { exitCode: 2 };
   485	  }
   486	  const { values, flags, positionals } = parsed;
   487	  const opusId = positionals[0];
   488	  if (!opusId) {
   489	    console.error(REVIEW_USAGE);
   490	    return { exitCode: 2 };
   491	  }
   492	
   493	  const pass = flags.has("--pass");
   494	  const fail = flags.has("--fail");
