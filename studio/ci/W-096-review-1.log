   392	const PLACEHOLDERS = new Set(["tbd", "todo", "pending", "placeholder", "n/a", "...", "insert findings", "insert recommendation"]);
   393	
   394	function contentLines(markdown: string): { headings: { level: number; name: string; line: number }[]; lines: { text: string; section?: string }[] } {
   395	  const headings: { level: number; name: string; line: number }[] = [];
   396	  const lines: { text: string; section?: string }[] = [];
   397	  let fence: string | undefined;
   398	  let comment = false;
   399	  let section: string | undefined;
   400	  for (const [index, raw] of markdown.split(/\r?\n/).entries()) {
   401	    const trimmed = raw.trim();
   402	    const fenceMatch = /^(```+|~~~+)/.exec(trimmed);
   403	    if (fenceMatch) {
   404	      if (!fence) fence = fenceMatch[1];
   405	      else if (trimmed.startsWith(fence[0]!.repeat(fence.length))) fence = undefined;
   406	      continue;
   407	    }
   408	    if (fence) continue;
   409	    let line = raw;
   410	    if (comment) {
   411	      const end = line.indexOf("-->");
   412	      if (end === -1) continue;
   413	      line = line.slice(end + 3);
   414	      comment = false;
   415	    }
   416	    while (line.includes("<!--")) {
   417	      const start = line.indexOf("<!--");
   418	      const end = line.indexOf("-->", start + 4);
   419	      if (end === -1) {
   420	        line = line.slice(0, start);
   421	        comment = true;
   422	        break;
   423	      }
   424	      line = line.slice(0, start) + line.slice(end + 3);
   425	    }
   426	    const heading = /^(#{1,2})\s+(.+?)\s*$/.exec(line.trim());
   427	    if (heading) {
   428	      const name = heading[2]!.trim();
   429	      headings.push({ level: heading[1]!.length, name, line: index });
   430	      section = heading[1]!.length === 2 ? name : undefined;
   431	      continue;
   432	    }
   433	    if (line.trim() !== "") lines.push({ text: line.trim(), section });
   434	  }
   435	  return { headings, lines };
   436	}
   437	
   438	function hasPlaceholder(text: string): boolean {
   439	  const folded = fullCaseFold(text.trim());
   440	  if (PLACEHOLDERS.has(folded)) return true;
   441	  const boundary = "[^\\p{L}\\p{M}\\p{N}]";
   442	  return new RegExp(
   443	    `(?:^|${boundary})(?:tbd|todo|pending|placeholder|n\\s*\\/\\s*a|\\.\\.\\.|insert\\s+findings|insert\\s+recommendation)(?=$|${boundary})`,
   444	    "u",
   445	  ).test(folded);
   446	}
