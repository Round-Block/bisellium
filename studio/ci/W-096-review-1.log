   138	/** Validate kind/title/date/hierarchy from already-parsed native records. */
   139	export function validateNativeRecord(record: NativeRecord, records: ReadonlyMap<string, NativeRecord> = new Map()): OpusModelProblem[] {
   140	  const problems: OpusModelProblem[] = [];
   141	  if (!isNativeOpusKind(record.kind)) problems.push({ rule: "opus.kind", message: `kind ${JSON.stringify(record.kind)} is not a native opus kind` });
   142	  const title = titleProblem(record.title);
   143	  if (title) problems.push({ rule: "opus.title", message: title });
   144	
   145	  const startProblem = record.start === undefined ? undefined : utcTimestampProblem(record.start);
   146	  const endProblem = record.end === undefined ? undefined : utcTimestampProblem(record.end);
   147	  if (startProblem) problems.push({ rule: "opus.dates", message: `start ${startProblem}` });
   148	  if (endProblem) problems.push({ rule: "opus.dates", message: `end ${endProblem}` });
   149	  if (record.end !== undefined && record.state !== "done") problems.push({ rule: "opus.dates", message: "end is valid only when state is done" });
   150	  if (!startProblem && !endProblem && typeof record.start === "string" && typeof record.end === "string" && instant(record.end) < instant(record.start))
   151	    problems.push({ rule: "opus.dates.order", message: "end precedes start" });
   152	
   153	  const id = typeof record.id === "string" ? record.id : undefined;
   154	  const kind = isNativeOpusKind(record.kind) ? record.kind : undefined;
   155	  const arc = record.arc;
   156	  const parent = record.parent;
   157	  if (record.ui_rulings !== undefined && kind !== "ui")
   158	    problems.push({ rule: "opus.ui.rulings", message: "ui_rulings is permitted only on ui records" });
   159	
   160	  if (kind === "arc") {
   161	    if (arc !== undefined) problems.push({ rule: "opus.arc", message: "an arc cannot itself name an arc" });
   162	    if (parent !== undefined) problems.push({ rule: "opus.parent", message: "an arc cannot name a parent" });
   163	  } else if (arc !== undefined) {
   164	    if (typeof arc !== "string" || !OPUS_ID.test(arc)) problems.push({ rule: "opus.arc", message: "arc must be a local opus id" });
   165	    else {
   166	      const target = records.get(arc);
   167	      if (!target) problems.push({ rule: "opus.arc", message: `arc ${arc} does not resolve in this officina` });
   168	      else if (target.kind !== "arc") problems.push({ rule: "opus.arc", message: `arc ${arc} does not name an arc record` });
   169	      if (arc === id) problems.push({ rule: "opus.arc", message: "an opus cannot be its own arc" });
   170	    }
   171	  }
   172	
   173	  if (kind === "subtask") {
   174	    if (typeof parent !== "string" || !OPUS_ID.test(parent)) problems.push({ rule: "opus.parent", message: "a subtask requires a local parent opus id" });
   175	    else {
   176	      const target = records.get(parent);
   177	      if (!target) problems.push({ rule: "opus.parent", message: `parent ${parent} does not resolve in this officina` });
   178	      else if (target.kind === "arc" || target.kind === "subtask") problems.push({ rule: "opus.parent", message: `parent ${parent} must be a non-arc, non-subtask opus` });
   179	      else {
   180	        const parentArc = typeof target.arc === "string" ? target.arc : undefined;
   181	        if (arc !== undefined && arc !== parentArc)
   182	          problems.push({ rule: "opus.arc", message: parentArc ? `subtask arc must equal its parent's arc ${parentArc}` : "subtask cannot introduce an arc its parent does not have" });
   183	      }
   184	      if (parent === id) problems.push({ rule: "opus.parent", message: "a subtask cannot be its own parent" });
   185	    }
   186	  } else if (parent !== undefined) {
   187	    problems.push({ rule: "opus.parent", message: "parent is permitted only on subtask records" });
   188	  }
   189	  return problems;
   190	}
