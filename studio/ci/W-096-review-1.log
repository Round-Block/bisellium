   536	    console.error(`${opusId}: opus.reference: ${unsafeReviewOpus}`);
   537	    return { exitCode: 2 };
   538	  }
   539	  const refusal = recordOwnerRefusal(root, opusId);
   540	  if (refusal !== undefined) {
   541	    console.error(refusal);
   542	    return { exitCode: 2 };
   543	  }
   544	
   545	  if (!isContained(root, evidence)) {
   546	    console.error(`${opusId}: --evidence "${evidence}" resolves outside the officina (D-008) — refused`);
   547	    return { exitCode: 2 };
   548	  }
   549	  if (!existsSync(join(root, evidence))) {
   550	    console.error(`--evidence "${evidence}" not found under studio`);
   551	    return { exitCode: 2 };
   552	  }
   553	
   554	  const currentState = readState(opusPath);
   555	  if (typeof currentState !== "string") {
