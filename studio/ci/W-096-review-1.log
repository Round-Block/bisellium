   376	
   377	export function parseVerdictHeader(text: string): ParsedHeader {
   378	  const lines = text.split(/\r?\n/);
   379	  const values = new Map<string, string>();
   380	  const duplicates: string[] = [];
   381	  let at = 0;
   382	  for (; at < lines.length; at++) {
   383	    const match = /^# ([a-z_]+): (.*)$/.exec(lines[at]!);
   384	    if (!match) break;
   385	    if (values.has(match[1]!)) duplicates.push(match[1]!);
   386	    else values.set(match[1]!, match[2]!);
   387	  }
   388	  while (at < lines.length && lines[at] === "") at++;
   389	  return { values, duplicates, body: lines.slice(at).join("\n") };
   390	}
