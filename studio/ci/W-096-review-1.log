   631	
   632	function ruling(root: string, record: NativeRecord, decisionId: string, digest: string, inputAt?: string, servedAt?: string, servedTree?: string): RulingResult {
   633	  if (!DECISION_ID.test(decisionId)) return { valid: false, current: false, problem: `${decisionId} is not a decision id` };
   634	  const file = readContainedRegularFile(root, `decisions/${decisionId}.md`, "decisions");
   635	  if ("error" in file) return { valid: false, current: false, problem: `${decisionId} is unsafe or unreadable: ${file.error}` };
   636	  const split = splitFront(file.bytes.toString("utf8"));
   637	  if (!split) return { valid: false, current: false, problem: `${decisionId} has no front matter` };
   638	  const doc = parseDocument(split.front, { uniqueKeys: true });
   639	  if (doc.errors.length || !isMap(doc.contents)) return { valid: false, current: false, problem: `${decisionId} has malformed or duplicate-key front matter` };
   640	  const scalar = (key: string): string | undefined => {
   641	    const node = doc.get(key, true);
   642	    return isScalar(node) && typeof node.value === "string" ? node.value : undefined;
   643	  };
   644	  const values = {
   645	    id: scalar("id"), by: scalar("by"), provenance: scalar("provenance"), title: scalar("title"), kill_when: scalar("kill_when"),
   646	    opus: scalar("opus"), certifies: scalar("certifies"), design_digest: scalar("design_digest"), at: scalar("at"),
   647	  };
   648	  if (values.id !== decisionId || values.by !== "patron" || values.provenance !== "stated" || !values.title?.trim() || !values.kill_when?.trim() || values.opus !== record.id || !values.certifies || !TREE_CERTIFICATE.test(values.certifies) || !values.design_digest || !DIGEST.test(values.design_digest) || !values.at || utcTimestampProblem(values.at) || split.body.trim() === "")
   649	    return { valid: false, current: false, problem: `${decisionId} is not a structured Patron UI ruling for this opus` };
   650	  const current =
   651	    inputAt !== undefined &&
   652	    servedAt !== undefined &&
   653	    servedTree !== undefined &&
   654	    values.certifies === servedTree &&
   655	    values.design_digest === digest &&
   656	    instant(values.at) >= Math.max(instant(inputAt), instant(servedAt));
   657	  return { valid: true, current };
   658	}
