   231	export function loadNativeRecords(root: string): LoadedNativeRecords {
   232	  const entries: NativeRecordEntry[] = [];
   233	  const records = new Map<string, NativeRecord>();
   234	  const problems: LoadedNativeRecords["problems"] = [];
   235	  let names: string[] = [];
   236	  try {
   237	    names = readdirSync(join(root, "opera")).filter((name) => name.endsWith(".md")).sort();
   238	  } catch {
   239	    return { entries, records, problems };
   240	  }
   241	  for (const name of names) {
   242	    const rel = `opera/${name}`;
   243	    const contained = readContainedRegularFile(root, rel, "opera");
   244	    if ("error" in contained) {
   245	      problems.push({ where: rel, problem: { rule: "opus.reference", message: contained.error } });
   246	      continue;
   247	    }
   248	    const split = splitFront(contained.bytes.toString("utf8"));
   249	    if (!split) continue;
   250	    const doc = parseDocument(split.front);
   251	    if (doc.errors.length) continue;
   252	    const value = doc.toJS() as unknown;
   253	    if (typeof value !== "object" || value === null || Array.isArray(value)) continue;
   254	    const data = value as NativeRecord;
   255	    for (const field of ["start", "end"] as const) {
   256	      if (data[field] === undefined) continue;
   257	      const node = doc.get(field, true);
   258	      if (!isScalar(node) || typeof node.value !== "string")
   259	        problems.push({ where: rel, problem: { rule: "opus.dates", message: `${field} must be a direct YAML string scalar` } });
   260	    }
   261	    entries.push({ path: contained.relative, data });
   262	    if (typeof data.id === "string") records.set(data.id, data);
   263	  }
   264	  return { entries, records, problems };
   265	}
