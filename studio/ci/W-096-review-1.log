   331	/** Remove the three contexts which carry examples rather than live
   332	 * citations. Fence tracking deliberately mirrors countBehaviours: only a
   333	 * backtick fence marker at Markdown's top three indentation columns toggles
   334	 * the fenced region. Inline code may use any matching backtick-run length;
   335	 * an unmatched delimiter is prose, not a span. */
   336	function citationProse(briefText: string): string {
   337	  const prose: string[] = [];
   338	  let inFence = false;
   339	  for (const line of briefText.split(/\r?\n/)) {
   340	    if (/^\s{0,3}```/.test(line)) {
   341	      inFence = !inFence;
   342	      continue;
   343	    }
   344	    if (!inFence) prose.push(line);
   345	  }
   346	  return prose
   347	    .map(stripBacktickSpans)
   348	    .join("\n")
   349	    .replace(/"(?:\\.|[^"\\])*"/g, "");
   350	}
   351	
   352	/** The exact replacement performed by /(`+)[^`\n]*?\1/g, without its
   353	 * quadratic backtracking. A full opening run can only close at the next
   354	 * run; when that fails, regexp capture backtracking can only pair ticks
   355	 * within the opening run itself. */
   356	function stripBacktickSpans(text: string): string {
   357	  const runs: { start: number; end: number; length: number }[] = [];
   358	  for (let cursor = 0; cursor < text.length; ) {
   359	    const start = text.indexOf("`", cursor);
   360	    if (start === -1) break;
   361	    let end = start + 1;
   362	    while (text[end] === "`") end++;
   363	    runs.push({ start, end, length: end - start });
   364	    cursor = end;
   365	  }
   366	
   367	  let output = "";
   368	  let copyFrom = 0;
   369	  let position = 0;
   370	  let runIndex = 0;
   371	  while (runIndex < runs.length) {
   372	    const run = runs[runIndex]!;
   373	    const start = Math.max(position, run.start);
   374	    if (start >= run.end) {
   375	      runIndex++;
   376	      continue;
   377	    }
   378	
   379	    const openingLength = run.end - start;
   380	    const next = runs[runIndex + 1];
   381	    if (next && next.length >= openingLength) {
   382	      output += text.slice(copyFrom, start);
   383	      position = next.start + openingLength;
   384	      copyFrom = position;
   385	      runIndex++;
   386	      continue;
   387	    }
   388	
   389	    const selfClosingLength = Math.floor(openingLength / 2);
   390	    if (selfClosingLength === 0) break;
   391	    output += text.slice(copyFrom, start);
   392	    position = start + 2 * selfClosingLength;
   393	    copyFrom = position;
   394	  }
   395	  return output + text.slice(copyFrom);
   396	}
