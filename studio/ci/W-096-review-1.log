   127	/** The leading `# key: value` header lines of a red log (W-020's contract),
   128	 *  stopping at the first non-header line. */
   129	function parseLogHeader(text: string): Map<string, string> {
   130	  const header = new Map<string, string>();
   131	  for (const line of text.split(/\r?\n/)) {
   132	    const m = /^#\s*([A-Za-z_]+):\s*(.*)$/.exec(line);
   133	    if (!m) break;
   134	    header.set(m[1]!.toLowerCase(), (m[2] ?? "").trim());
   135	  }
   136	  return header;
   137	}
   138	
   139	function stripHeader(text: string): string {
   140	  const lines = text.split(/\r?\n/);
   141	  const firstNonHeader = lines.findIndex((l) => !/^#\s*[A-Za-z_]+:/.test(l));
   142	  return (firstNonHeader === -1 ? [] : lines.slice(firstNonHeader)).join("\n").trim();
   143	}
   144	
   145	export function isDuplicateRed(a: string, b: string): boolean {
   146	  const bodyA = stripHeader(a);
   147	  const bodyB = stripHeader(b);
   148	  return bodyA.length > 0 && bodyA === bodyB;
   149	}
