   402	    try {
   403	      if (!lstatSync(p).isFile()) continue;
   404	      briefText = readFileSync(p, "utf8");
   405	    } catch {
   406	      continue;
   407	    }
   408	
   409	    const declared = countBehaviours(briefText);
   410	    if (declared === 0) continue;
   411	    for (const match of citationProse(briefText).matchAll(/\bBehaviour (\d+)\b/g)) {
   412	      const cited = Number(match[1]);
