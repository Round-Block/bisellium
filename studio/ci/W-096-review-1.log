   342	export function shingles(words: readonly string[], width = PROMPT_SHINGLE_WORDS): Set<string> {
   343	  const result = new Set<string>();
   344	  for (let i = 0; i + width <= words.length; i++) result.add(words.slice(i, i + width).join(" "));
   345	  return result;
   346	}
