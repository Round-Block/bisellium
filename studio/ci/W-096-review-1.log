    51	type IntegrationStrategy = "fast_forward" | "rebase" | "merge_commit";
    52	const STRATEGIES: IntegrationStrategy[] = ["fast_forward", "rebase", "merge_commit"];
    53	
    54	interface ResolvedIntegration {
    55	  strategy: IntegrationStrategy;
    56	  push: boolean;
    57	  pullAfterPush: boolean;
    58	  prRequired: boolean;
    59	  prReviewer?: string;
