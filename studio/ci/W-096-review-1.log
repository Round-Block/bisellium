   157	function checkRedEvidence(root: string): Finding[] {
   158	  const redsDir = join(root, "ci", "reds");
   159	  if (!existsSync(redsDir)) return [];
   160	
   161	  const findings: Finding[] = [];
   162	  for (const p of safeList(join(root, "opera"))) {
   163	    const d = safeFront(p);
   164	    if (!d) continue;
   165	    const state = str(d["state"]);
   166	    if (!state || !ACTIVE.has(state)) continue;
   167	    const id = str(d["id"]);
   168	    const spec = str(d["spec"]);
   169	    if (!id || !spec) continue;
   170	
   171	    const briefAbs = resolve(root, spec);
   172	    const briefRel = relative(root, briefAbs);
   173	    if (isAbsolute(briefRel) || briefRel.split(sep)[0] === "..") continue; // must resolve inside the officina
   174	
   175	    let briefText: string;
   176	    try {
   177	      briefText = readFileSync(briefAbs, "utf8");
   178	    } catch {
   179	      continue;
   180	    }
   181	
   182	    const where = relative(root, p).split(sep).join("/");
   183	    const n = countBehaviours(briefText);
   184	    if (n === 0) {
   185	      findings.push({
   186	        rule: "opus.red_evidence",
   187	        level: "advise",
   188	        where,
   189	        message: "brief lists no numbered behaviours — nothing to prove",
   190	      });
   191	      continue;
   192	    }
   193	
   194	    const missing: number[] = [];
   195	    const notRed: number[] = [];
   196	    const moduleLoad: number[] = [];
   197	    const logTexts = new Map<number, string>();
   198	    for (let nn = 1; nn <= n; nn++) {
   199	      const logPath = join(redsDir, id, `${String(nn).padStart(2, "0")}.log`);
   200	      if (!existsSync(logPath)) {
   201	        missing.push(nn);
   202	        continue;
   203	      }
   204	      let logText: string;
   205	      try {
   206	        logText = readFileSync(logPath, "utf8");
   207	      } catch {
   208	        missing.push(nn);
   209	        continue;
   210	      }
   211	      logTexts.set(nn, logText);
   212	      const exit = parseLogHeader(logText).get("exit");
   213	      if (exit === undefined || !/^-?\d+$/.test(exit) || exit === "0") notRed.push(nn);
   214	      if (isModuleLoadFailure(logText)) moduleLoad.push(nn);
   215	    }
   216	
   217	    // P-005 part 2: module-load failure is not assertion-level
   218	    if (moduleLoad.length)
   219	      findings.push({
   220	        rule: "opus.red_content",
   221	        level: "advise",
   222	        where,
   223	        message: `red(s) for behaviour(s) ${moduleLoad.join(", ")} are module-load failures, not assertion-level`,
   224	      });
   225	
   226	    // P-005 part 1: duplicate reds (byte-identical after header strip)
   227	    const texts = [...logTexts.entries()];
   228	    for (let i = 0; i < texts.length; i++) {
   229	      for (let j = i + 1; j < texts.length; j++) {
   230	        if (isDuplicateRed(texts[i]![1], texts[j]![1])) {
   231	          findings.push({
   232	            rule: "opus.red_content",
   233	            level: "block",
   234	            where,
   235	            message: `red logs for behaviours ${texts[i]![0]} and ${texts[j]![0]} are identical after header strip`,
   236	          });
   237	        }
   238	      }
   239	    }
   240	
   241	    if (missing.length)
   242	      findings.push({
   243	        rule: "opus.red_evidence",
   244	        level: "block",
   245	        where,
   246	        message: `missing red log(s) for behaviour(s) ${missing.join(", ")}`,
   247	      });
   248	    if (notRed.length)
   249	      findings.push({
   250	        rule: "opus.red_evidence",
   251	        level: "block",
   252	        where,
   253	        message: `red log(s) for behaviour(s) ${notRed.join(", ")} record a passing run, not a red`,
   254	      });
   255	
   256	    // W-039: opus.red_sella (advise). logTexts is already scoped to this
   257	    // opus's in-contract behaviours 1..n — an off-contract file (e.g.
   258	    // close-bugs-red.log) was never read into it. A log names no one when
   259	    // its header has no `sella` key, or the trimmed value is empty or
   260	    // "guest" (the anonymity this rule flags, not the name itself).
   261	    const noSella: string[] = [];
   262	    for (const [nn, logText] of logTexts) {
   263	      const sella = parseLogHeader(logText).get("sella")?.trim();
   264	      if (sella === undefined || sella === "" || sella === "guest") noSella.push(`${String(nn).padStart(2, "0")}.log`);
   265	    }
   266	    if (noSella.length)
   267	      findings.push({
   268	        rule: "opus.red_sella",
   269	        level: "advise",
   270	        where: `ci/reds/${id}/`,
   271	        message: `${noSella.length} red log(s) record no sella: ${noSella.join(", ")}`,
   272	      });
   273	  }
   274	  return findings;
   275	}
