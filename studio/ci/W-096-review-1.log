   575	    ...currentFront,
   576	    state: fail && (currentState === "review" || currentState === "done") ? "building" : currentState,
   577	    ...(fail && currentState === "done" ? { end: undefined } : {}),
   578	    probationes: {
   579	      ...currentGates,
   580	      [reviewProbatioId]: { status, evidence, sella, at: now.toISOString(), ...(model === undefined ? {} : { model }) },
