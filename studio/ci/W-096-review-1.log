     4	 * `amend`). Replaces the two stopgap scripts (`scripts/opus-ready.ts`,
     5	 * `scripts/opus-close.ts`, both deleted by this opus) and adds the third
     6	 * piece P-001/P-003 decreed: a per-behaviour red store at
     7	 * `<studio>/ci/reds/<opus>/`, written only through `red`. Kept out of
     8	 * main.ts's generic flag table on purpose, same as `verify`/`talk` — each of
     9	 * these parses its own argv.
    10	 *
    11	 * Every front-matter write goes through `editOpusFrontMatter` (merge into
    12	 * the yaml Document, body byte-for-byte) — the same discipline writes.ts's
    13	 * five commands already follow. `ready`/`done`/`review` share writes.ts's
    14	 * plumbing (`parseFlags`, `openStudio`, `safeItemPath`, `readState`,
    15	 * `resolveNow`, `emitEvent`) rather than re-deriving it.
    16	 */
    17	import { spawn } from "node:child_process";
    18	import { execFileSync } from "node:child_process";
    19	import { existsSync, mkdirSync, realpathSync, writeFileSync } from "node:fs";
    20	import { dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
    21	import { isSeq } from "yaml";
    22	import { readFront, resolveSeat, type Manifest } from "@bisellium/adapter-native";
    23	import { isDirtyOutside, sourceTreeHash } from "@bisellium/shim";
    24	import { WF } from "@bisellium/schema";
    25	import { editOpusFrontMatter } from "./frontmatter.js";
    26	import {
    27	  effectiveProbationes,
    28	  loadNativeRecords,
    29	  readContainedRegularFile,
    30	  titleProblem,
    31	  utcTimestampProblem,
    32	  validateNativeRecord,
    33	  validateRecordReferences,
    34	  validateUiPolicy,
    35	  type NativeRecord,
    36	  type OpusModelProblem,
    37	} from "./opus-model.js";
    38	import {
    39	  emitEvent,
    40	  mintDispatchSella,
    41	  openStudio,
    42	  parseFlags,
    43	  readState,
    44	  recordOwnerRefusal,
    45	  resolveNow,
    46	  safeItemPath,
    47	  type WriteOptions,
    48	  type WriteResult,
    49	} from "./writes.js";
    50	
    51	const GIT_TIMEOUT_MS = 30_000;
    52	
    53	/** The CLI-wide un-credentialed default (`main.ts:188`'s own
    54	 *  `--sella ?? $BISELLIUM_SELLA ?? "guest"` chain, `CLAUDE.md`,
    55	 *  `.claude/settings.json`'s hook commands): a built-in identity like
    56	 *  `patron`, never a roster row `bisellium init` is obliged to scaffold
    57	 *  (censor W-089 round-1 finding B2 — a freshly-scaffolded officina declares
    58	 *  only `producer`, and `guest` was refused there once this opus added the
    59	 *  roster check below). Never builder-class, so there is nothing to mint. */
    60	const GUEST_SELLA = "guest";
    61	
    62	/** Same fallback chain `context`/`hook-event` already use: an explicit
    63	 *  `--sella`, else $BISELLIUM_SELLA, else the "guest" sella every studio
    64	 *  declares. W-089 behaviour 6: roster-aware — the selected name is then
    65	 *  resolved against the manifest (template, instance, or a retired
    66	 *  tombstone all pass; this is an ATTRIBUTION gate, not a live-dispatch one,
    67	 *  so a retired id is accepted here and refused only at the load-bearing
    68	 *  sites in run.ts/writes.ts). An id that resolves to nothing is a usage
    69	 *  error, not a silent write. W-089 behaviour 5 (censor round-1 finding B1):
    70	 *  a resolved LIVE builder-class template is then minted against `opusId`
    71	 *  through `mintDispatchSella` — the same helper writes.ts's handoff/
    72	 *  emit --usage already call (S2) — so `ready`/`done`/`review`/`halt`/
    73	 *  `waive` never write or attribute a bare `builder`/`builder-codex`. */
    74	function resolveSella(flagValue: string | undefined, manifest: Manifest, opusId: string, verb: string): string | { error: string } {
    75	  const sella = flagValue ?? process.env["BISELLIUM_SELLA"] ?? GUEST_SELLA;
    76	  if (sella === GUEST_SELLA) return sella;
    77	  const resolved = resolveSeat(manifest, sella);
    78	  if (!resolved) return { error: `${verb}: unknown sella "${sella}" — not declared in bisellium.yml` };
    79	  const minted = mintDispatchSella(resolved, sella, opusId, verb);
    80	  return "error" in minted ? minted : minted.sella;
    81	}
    82	
    83	/** `red`'s own resolver (W-039): a red log is permanent evidence — once its
    84	 *  behaviour is implemented the same red can never be recorded again — so,
    85	 *  unlike `resolveSella`, this never falls back to "guest" on its own.
    86	 *  Returns `undefined` when neither `flagValue` nor `$BISELLIUM_SELLA` names
    87	 *  anyone (W-039's own no-name refusal, kept distinct — the caller checks
    88	 *  this before the roster check below runs). Otherwise (W-089 behaviour 6)
    89	 *  the selected name is resolved against the manifest the same way
    90	 *  `resolveSella` does — a retired tombstone passes (attribution, not
    91	 *  dispatch) and a LIVE builder-class template mints against `opusId`
    92	 *  (behaviour 5, same `mintDispatchSella` call `resolveSella` makes); an id
    93	 *  that resolves to nothing is `{ error }`. Empty and whitespace-only count
    94	 *  as unset in both places; a repeated `--sella` is `parseFlags`' own
    95	 *  last-value-wins (`writes.ts`), not scanned here. Reads `process.env`
    96	 *  once. Not exported: `runRed` and `runAmend` are its only callers, and
    97	 *  keeping it unexported turns an import-shape mistake in a test into a
    98	 *  module-load failure rather than a silently-passing red. */
    99	function namedSella(flagValue: string | undefined, manifest: Manifest, opusId: string, verb: string): string | { error: string } | undefined {
   100	  const envValue = process.env["BISELLIUM_SELLA"];
   101	  let name: string | undefined;
   102	  if (flagValue !== undefined && flagValue.trim() !== "") name = flagValue;
   103	  else if (envValue !== undefined && envValue.trim() !== "") name = envValue;
   104	  if (name === undefined) return undefined;
   105	  if (name === GUEST_SELLA) return name;
   106	  const resolved = resolveSeat(manifest, name);
   107	  if (!resolved) return { error: `${verb}: unknown sella "${name}" — not declared in bisellium.yml` };
   108	  const minted = mintDispatchSella(resolved, name, opusId, verb);
   109	  return "error" in minted ? minted : minted.sella;
   110	}
   111	
   112	interface OpusFront {
   113	  id?: unknown;
   114	  kind?: unknown;
   115	  collegium?: unknown;
   116	  state?: unknown;
   117	  probationes?: Record<string, { status?: unknown; evidence?: unknown; certifies?: unknown; reason?: unknown; waived_by?: unknown }>;
   118	  title?: unknown;
   119	  spec?: unknown;
   120	  arc?: unknown;
   121	  parent?: unknown;
   122	  start?: unknown;
   123	  end?: unknown;
   124	  ui_rulings?: unknown;
   125	}
   126	
   127	function resolveExactNow(raw: string | undefined, fallback: Date | undefined): Date | undefined {
   128	  if (raw !== undefined && utcTimestampProblem(raw)) return undefined;
   129	  const value = resolveNow(raw, fallback);
   130	  if (!value) return undefined;
   131	  try { return utcTimestampProblem(value.toISOString()) ? undefined : value; }
   132	  catch { return undefined; }
   133	}
   134	
   135	function nativePreflight(
   136	  root: string,
   137	  manifest: Manifest,
   138	  opusId: string,
   139	  record: NativeRecord,
   140	  phase: "check" | "ready" | "done" = "check",
   141	): OpusModelProblem[] {
   142	  const loaded = loadNativeRecords(root);
   143	  const problems = loaded.problems.map(({ problem }) => problem);
   144	  const records = new Map(loaded.records);
   145	  records.set(opusId, record);
   146	  // The native checker reports a missing kind on disk, but lifecycle writes
   147	  // predate that field being required.  Preserve those legacy records'
   148	  // transitions while still refusing every supplied non-native kind.  UI
   149	  // policy remains opt-in only through an explicit `kind: ui` below.
   150	  problems.push(
   151	    ...validateNativeRecord(record, records).filter((problem) => record.kind !== undefined || problem.rule !== "opus.kind"),
   152	  );
   153	  problems.push(...validateRecordReferences(root, record));
   154	  problems.push(...validateUiPolicy({ root, record, manifest, phase }));
   155	  return problems;
   156	}
   157	
   158	function refuseModel(opusId: string, problems: readonly OpusModelProblem[]): boolean {
   159	  const blocking = problems.filter((problem) => problem.level !== "advise");
   160	  if (blocking.length === 0) return false;
   161	  console.error(blocking.map((problem) => `${opusId}: ${problem.rule}: ${problem.message}`).join("\n"));
   162	  return true;
   163	}
   164	
   165	function unsafeOpusProblem(root: string, opusId: string): string | undefined {
   166	  const inspected = readContainedRegularFile(root, `opera/${opusId}.md`, "opera");
   167	  return "error" in inspected ? inspected.error : undefined;
   168	}
   169	
   170	function uiSourceProblem(root: string, manifest: Manifest, record: NativeRecord): string | undefined {
   171	  if (record.kind !== "ui") return undefined;
   172	  const gates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes)
   173	    ? (record.probationes as Record<string, unknown>)
   174	    : {};
   175	  const served = typeof gates["served-e2e"] === "object" && gates["served-e2e"] !== null && !Array.isArray(gates["served-e2e"])
   176	    ? (gates["served-e2e"] as Record<string, unknown>)
   177	    : {};
   178	  const expected = typeof served["certifies"] === "string" ? served["certifies"] : undefined;
   179	  try {
   180	    const repo = execFileSync("git", ["rev-parse", "--show-toplevel"], { cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], timeout: GIT_TIMEOUT_MS }).trim();
   181	    const studioRel = relative(repo, root);
   182	    if (isAbsolute(studioRel) || studioRel.split(sep)[0] === "..") return "could not establish the current SOURCE tree";
   183	    const exclusions = [studioRel.split(sep).join("/"), ".bisellium", ...(manifest.source_excludes ?? [])];
   184	    if (isDirtyOutside(repo, exclusions)) return "current SOURCE tree is dirty";
   185	    const actual = `tree:${sourceTreeHash(repo, exclusions, "HEAD")}`;
   186	    return expected === actual ? undefined : `served-e2e certifies ${expected ?? "nothing"}, current SOURCE is ${actual}`;
   187	  } catch (error) {
   188	    return `current SOURCE tree is unavailable: ${(error as Error).message}`;
   189	  }
   190	}
   191	
   192	/** True when `relPath` resolved against `root` stays inside it — D-008's
   193	 *  resolved-path relation (`relative()`, first segment check), never a
   194	 *  `startsWith`/`join()`-only test. Shared by `ready --spec` and
   195	 *  `review --evidence`, the two ids-into-paths this opus itself writes. */
   196	function isContained(root: string, relPath: string): boolean {
   197	  const rel = relative(root, resolve(root, relPath));
   198	  if (isAbsolute(rel)) return false;
   199	  return rel.split(sep)[0] !== "..";
   200	}
   201	
   202	// ---------------------------------------------------------------------------
   203	// 1. ready — greenlit|halted -> building (scripts/opus-ready.ts, plus the event)
   204	// ---------------------------------------------------------------------------
   205	
   206	const READY_USAGE = "usage: bisellium ready <opus> [--spec <path>] [--sella <id>] [--studio <dir>] [--now <iso>]";
   207	
   208	export function runReady(args: string[], opts: WriteOptions = {}): WriteResult {
   209	  const parsed = parseFlags(args, { valued: ["--spec", "--sella", "--studio", "--now"] });
   210	  if ("error" in parsed) {
   211	    console.error(`${parsed.error}\n${READY_USAGE}`);
   212	    return { exitCode: 2 };
   213	  }
   214	  const { values, positionals } = parsed;
   215	  const opusId = positionals[0];
   216	  if (!opusId) {
   217	    console.error(READY_USAGE);
   218	    return { exitCode: 2 };
   219	  }
   220	
   221	  const now = resolveExactNow(values.get("--now"), opts.now);
   222	  if (!now) {
   223	    console.error("--now must match the exact UTC timestamp profile");
   224	    return { exitCode: 2 };
   225	  }
   226	
   227	  const opened = openStudio(values.get("--studio"));
   228	  if ("error" in opened) {
   229	    console.error(opened.error);
   230	    return { exitCode: 2 };
   231	  }
   232	  const { root, manifest } = opened;
   233	
   234	  const opusPath = safeItemPath(join(root, "opera"), opusId);
   235	  if (typeof opusPath !== "string" || !existsSync(opusPath)) {
   236	    console.error(`unknown opus: ${opusId}`);
   237	    return { exitCode: 2 };
   238	  }
   239	  const unsafeOpus = unsafeOpusProblem(root, opusId);
   240	  if (unsafeOpus) {
   241	    console.error(`${opusId}: opus.reference: ${unsafeOpus}`);
   242	    return { exitCode: 2 };
   243	  }
   244	
   245	  // D-021 (W-033 round-1 A1): right after the record-existence check, before
   246	  // any state/spec check, so a trunk caller gets the ownership message
   247	  // rather than a "not greenlit or halted"/"no spec" refusal.
   248	  const refusal = recordOwnerRefusal(root, opusId);
   249	  if (refusal !== undefined) {
   250	    console.error(refusal);
   251	    return { exitCode: 2 };
   252	  }
   253	
   254	  const currentState = readState(opusPath);
   255	  if (typeof currentState !== "string") {
   256	    console.error(currentState.error);
   257	    return { exitCode: 2 };
   258	  }
   259	  if (currentState !== "greenlit" && currentState !== "halted") {
   260	    console.error(`${opusId} is not greenlit or halted (state: ${currentState || "?"})`);
   261	    return { exitCode: 2 };
   262	  }
   263	
   264	  const specRel = values.get("--spec") ?? `briefs/${opusId}.md`;
   265	  if (!isContained(root, specRel)) {
   266	    console.error(`${opusId}: --spec "${specRel}" resolves outside the officina (D-008) — refused`);
   267	    return { exitCode: 2 };
   268	  }
   269	  const containedSpec = readContainedRegularFile(root, specRel, "briefs");
   270	  if ("error" in containedSpec) {
   271	    console.error(`${opusId}: no safe spec at ${specRel} — ${containedSpec.error}`);
   272	    return { exitCode: 2 };
   273	  }
   274	
   275	  const sellaResult = resolveSella(values.get("--sella"), manifest, opusId, "ready");
   276	  if (typeof sellaResult !== "string") {
   277	    console.error(sellaResult.error);
   278	    return { exitCode: 2 };
   279	  }
   280	  const sella = sellaResult;
   281	  const hasSpecProbatio = manifest.probationes.some((p) => p.id === "spec");
   282	  const currentFront = readFront<NativeRecord>(opusPath).data;
   283	  const proposed: NativeRecord = {
   284	    ...currentFront,
   285	    spec: specRel,
   286	    start: currentFront.start === undefined ? now.toISOString() : currentFront.start,
   287	  };
   288	  if (refuseModel(opusId, nativePreflight(root, manifest, opusId, proposed, "ready"))) return { exitCode: 1 };
   289	
   290	  editOpusFrontMatter(opusPath, (doc) => {
   291	    doc.setIn(["spec"], specRel);
   292	    if (hasSpecProbatio) {
   293	      doc.setIn(["probationes", "spec", "sella"], sella);
   294	      doc.setIn(["probationes", "spec", "status"], "passed");
   295	      doc.setIn(["probationes", "spec", "evidence"], specRel);
   296	      doc.setIn(["probationes", "spec", "at"], now.toISOString());
   297	    }
   298	    doc.setIn(["state"], "building");
   299	    if (doc.get("start") === undefined) doc.set("start", now.toISOString());
   300	    // A halt's exit conditions describe a state this opus is no longer in.
   301	    for (const k of ["halted_at", "reason", "resume_when", "halted_by"]) doc.delete(k);
   302	    return undefined;
   303	  });
   304	
   305	  emitEvent(root, manifest, "workflow.state_changed", now, {
   306	    [WF.ITEM_ID]: opusId,
   307	    [WF.STATE_FROM]: currentState,
   308	    [WF.STATE_TO]: "building",
   309	    [WF.ACTOR_ROLE]: sella,
   310	  });
   311	
   312	  console.log(`${opusId}: spec=${specRel} state=building`);
   313	  return { exitCode: 0 };
   314	}
   315	
   316	// ---------------------------------------------------------------------------
   317	// 2. done — building|verifying|review -> done (scripts/opus-close.ts, plus the event)
   318	// ---------------------------------------------------------------------------
   319	
   320	const DONE_USAGE = "usage: bisellium done <opus> [--sella <id>] [--studio <dir>] [--now <iso>]";
   321	const DONE_FROM_STATES = new Set(["building", "verifying", "review"]);
   322	
   323	export function runDone(args: string[], opts: WriteOptions = {}): WriteResult {
   324	  const parsed = parseFlags(args, { valued: ["--sella", "--studio", "--now"] });
   325	  if ("error" in parsed) {
   326	    console.error(`${parsed.error}\n${DONE_USAGE}`);
   327	    return { exitCode: 2 };
   328	  }
   329	  const { values, positionals } = parsed;
   330	  const opusId = positionals[0];
   331	  if (!opusId) {
   332	    console.error(DONE_USAGE);
   333	    return { exitCode: 2 };
   334	  }
   335	
   336	  const now = resolveExactNow(values.get("--now"), opts.now);
   337	  if (!now) {
   338	    console.error("--now must be an ISO date");
   339	    return { exitCode: 2 };
   340	  }
   341	
   342	  const opened = openStudio(values.get("--studio"));
   343	  if ("error" in opened) {
   344	    console.error(opened.error);
   345	    return { exitCode: 2 };
   346	  }
   347	  const { root, manifest } = opened;
   348	
   349	  const opusPath = safeItemPath(join(root, "opera"), opusId);
   350	  if (typeof opusPath !== "string" || !existsSync(opusPath)) {
   351	    console.error(`unknown opus: ${opusId}`);
   352	    return { exitCode: 2 };
   353	  }
   354	  // D-021 (W-033 round-1 A1): right after the record-existence check, before
   355	  // any state/gate check, so a trunk caller gets the ownership message
   356	  // rather than "not building, verifying or review" or a gate refusal.
   357	  const unsafeDoneOpus = unsafeOpusProblem(root, opusId);
   358	  if (unsafeDoneOpus) {
   359	    console.error(`${opusId}: opus.reference: ${unsafeDoneOpus}`);
   360	    return { exitCode: 2 };
   361	  }
   362	  const refusal = recordOwnerRefusal(root, opusId);
   363	  if (refusal !== undefined) {
   364	    console.error(refusal);
   365	    return { exitCode: 2 };
   366	  }
   367	
   368	  // Read off disk with readFront, never a regex over raw YAML (that was
   369	  // opus-close.ts's own shortcut, and the reason it's deleted).
   370	  const front = readFront<OpusFront>(opusPath).data;
   371	  const currentState = typeof front.state === "string" ? front.state : "";
   372	  // Not one of the three states this write accepts from: same "any other
   373	  // current state is a refusal" shape ready's greenlit/halted guard uses.
   374	  if (!DONE_FROM_STATES.has(currentState)) {
   375	    console.error(`${opusId} is not building, verifying or review (state: ${currentState || "?"})`);
   376	    return { exitCode: 2 };
   377	  }
   378	
   379	  if (refuseModel(opusId, nativePreflight(root, manifest, opusId, front as NativeRecord))) return { exitCode: 1 };
   380	  const proposedDone: NativeRecord = { ...(front as NativeRecord), state: "done", end: now.toISOString() };
   381	  if (refuseModel(opusId, nativePreflight(root, manifest, opusId, proposedDone, "done"))) return { exitCode: 1 };
   382	  const sourceProblem = uiSourceProblem(root, manifest, front as NativeRecord);
   383	  if (sourceProblem) {
   384	    console.error(`${opusId}: opus.ui.e2e: ${sourceProblem}`);
   385	    return { exitCode: 1 };
   386	  }
   387	
   388	  const recorded = front.probationes ?? {};
   389	  const missing: string[] = [];
   390	  // Per-gate refusal detail (W-034): the first line ("gates not passed: …")
   391	  // names every refused gate id; this carries the *why* for a waived one —
   392	  // never for an ordinary unrecorded/pending/failed/stale gate, which the
   393	  // first line already explains completely.
   394	  const detail: string[] = [];
   395	  // Honourable human-gate waivers `done` actually honours — named
   396	  // permanently on stdout (never a silent pass): "done (waived: patron by
   397	  // D-900)". A waiver is never rewritten into a `passed`.
   398	  const honoured: { id: string; decision: string }[] = [];
   399	  const effective = effectiveProbationes(front.kind, manifest.probationes);
   400	  if (refuseModel(opusId, effective.problems)) return { exitCode: 1 };
   401	  for (const p of effective.probationes) {
   402	    const rec = recorded[p.id];
   403	    const status = typeof rec?.status === "string" ? rec.status : undefined;
   404	    const certifies = typeof rec?.certifies === "string" ? rec.certifies : undefined;
   405	    if (p.kind === "automated") {
   406	      if (status === "waived") {
   407	        missing.push(p.id);
   408	        detail.push(
   409	          `${p.id}: probatio.waived.automated — no CLI verb writes a waived automated gate; ` +
   410	            `revert the out-of-band write with git, then run "bisellium verify"`,
   411	        );
   412	      } else if (status !== "passed" || !certifies?.startsWith("tree:")) {
   413	        missing.push(p.id);
   414	      }
   415	    } else if (p.kind === "agent") {
   416	      if (status === "waived") {
   417	        missing.push(p.id);
   418	        detail.push(`${p.id}: probatio.waived.agent`);
   419	      } else if (status !== "passed") {
   420	        missing.push(p.id);
   421	      }
   422	    } else if (p.kind === "human") {
   423	      // An unrecorded human gate is not demanded — same asymmetry
   424	      // check.ts's state.done.probationes rule already has.
   425	      if (rec === undefined || status === "passed") continue;
   426	      if (status === "waived") {
   427	        const reason = rec.reason;
   428	        const reasonOk = typeof reason === "string" && reason.trim().length > 0;
   429	        const problem = reasonOk ? patronDecisionProblem(root, manifest, rec.waived_by) : `gate "${p.id}" waived with no reason`;
   430	        if (problem === undefined) honoured.push({ id: p.id, decision: rec.waived_by as string });
   431	        else {
   432	          missing.push(p.id);
   433	          detail.push(`${p.id}: ${problem}`);
   434	        }
   435	      } else {
   436	        missing.push(p.id);
   437	      }
   438	    }
   439	  }
   440	  if (missing.length) {
   441	    console.error([`${opusId}: gates not passed: ${missing.join(", ")}`, ...detail].join("\n"));
   442	    return { exitCode: 1 };
   443	  }
   444	
   445	  const doneSellaResult = resolveSella(values.get("--sella"), manifest, opusId, "done");
   446	  if (typeof doneSellaResult !== "string") {
   447	    console.error(doneSellaResult.error);
   448	    return { exitCode: 2 };
   449	  }
   450	  const sella = doneSellaResult;
   451	
   452	  editOpusFrontMatter(opusPath, (doc) => {
   453	    doc.setIn(["state"], "done");
   454	    doc.setIn(["end"], now.toISOString());
   455	    return undefined;
   456	  });
   457	
   458	  emitEvent(root, manifest, "workflow.state_changed", now, {
   459	    [WF.ITEM_ID]: opusId,
   460	    [WF.STATE_FROM]: currentState,
