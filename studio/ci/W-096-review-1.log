   416	        level: "block",
   417	        where: relative(root, p).split(sep).join("/"),
   418	        message: `brief cites Behaviour ${cited} but declares ${declared} behaviours`,
   419	      });
   420	    }
   421	  }
   422	  return findings;
   423	}
