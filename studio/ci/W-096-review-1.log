   567	  const status = pass ? "passed" : "failed";
   568	  const model = values.get("--model");
   569	  const currentFront = readFront<NativeRecord>(opusPath).data;
   570	  const currentGates =
   571	    typeof currentFront.probationes === "object" && currentFront.probationes !== null && !Array.isArray(currentFront.probationes)
