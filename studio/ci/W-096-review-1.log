   729	export function validateStudioNativeModel(root: string, manifest: Pick<Manifest, "sellae" | "probationes">): { where: string; problem: OpusModelProblem }[] {
   730	  const loaded = loadNativeRecords(root);
   731	  const out = [...loaded.problems];
   732	  for (const entry of loaded.entries) {
   733	    for (const problem of validateNativeRecord(entry.data, loaded.records)) out.push({ where: entry.path, problem });
   734	    for (const problem of validateRecordReferences(root, entry.data)) out.push({ where: entry.path, problem });
   735	    for (const problem of validateUiPolicy({ root, record: entry.data, manifest, phase: "check" })) out.push({ where: entry.path, problem });
   736	  }
   737	  return out;
   738	}
