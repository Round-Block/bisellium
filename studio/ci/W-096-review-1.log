   198	/**
   199	 * Resolve a studio-relative regular file without following a symlink in any
   200	 * path component. `expectedDir` is the required first component.
   201	 */
   202	export function readContainedRegularFile(root: string, relPath: string, expectedDir: string): ContainedFile | { error: string } {
   203	  if (typeof relPath !== "string" || relPath.length === 0 || isAbsolute(relPath)) return { error: "path must be a nonempty officina-relative string" };
   204	  const lexical = resolve(root, relPath);
   205	  const rel = relative(resolve(root), lexical);
   206	  const parts = rel.split(sep);
   207	  if (isAbsolute(rel) || parts[0] === ".." || parts[0] !== expectedDir) return { error: `path must remain under ${expectedDir}/` };
   208	  try {
   209	    let cursor = resolve(root);
   210	    for (const part of parts) {
   211	      cursor = join(cursor, part);
   212	      if (lstatSync(cursor).isSymbolicLink()) return { error: "path reaches its target through a symlink" };
   213	    }
   214	    if (!statSync(lexical).isFile()) return { error: "target is not a regular file" };
   215	    const rootReal = realpathSync(root);
   216	    const real = realpathSync(lexical);
   217	    const realRel = relative(rootReal, real);
   218	    if (isAbsolute(realRel) || realRel.split(sep)[0] === ".." || realRel.split(sep)[0] !== expectedDir) return { error: `real target escapes ${expectedDir}/` };
   219	    return { absolute: lexical, relative: parts.join("/"), bytes: readFileSync(lexical) };
   220	  } catch (error) {
   221	    return { error: (error as Error).message };
   222	  }
   223	}
