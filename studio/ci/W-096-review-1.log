   110	function leap(year: number): boolean {
   111	  return year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
   112	}
   113	
   114	export function utcTimestampProblem(value: unknown): string | undefined {
   115	  if (typeof value !== "string") return "must be a string in the exact UTC timestamp profile";
   116	  const match = UTC_PROFILE.exec(value);
   117	  if (!match) return "must match YYYY-MM-DDTHH:MM:SS[.sss]Z";
   118	  const year = Number(match[1]);
   119	  const month = Number(match[2]);
   120	  const day = Number(match[3]);
   121	  if (year === 0) return "year 0000 is not valid";
   122	  const lengths = [31, leap(year) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
   123	  if (day > lengths[month - 1]!) return "date is not a real Gregorian calendar day";
   124	  return undefined;
   125	}
