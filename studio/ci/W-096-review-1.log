   348	export interface PromptComparison {
   349	  transcript: number;
   350	  prompt: number;
   351	  shared: number;
   352	  novel: number;
   353	  accepted: boolean;
   354	}
   355	
   356	export function comparePrompt(transcriptText: string, promptText: string): PromptComparison {
   357	  const transcript = shingles(normalizedWords(transcriptText));
   358	  const prompt = shingles(normalizedWords(promptText));
   359	  let shared = 0;
   360	  for (const value of transcript) if (prompt.has(value)) shared++;
   361	  const novel = transcript.size - shared;
   362	  return {
   363	    transcript: transcript.size,
   364	    prompt: prompt.size,
   365	    shared,
   366	    novel,
   367	    accepted: transcript.size > 0 && 10 * shared <= 3 * transcript.size && novel >= PROMPT_MIN_NOVEL_SHINGLES,
   368	  };
   369	}
