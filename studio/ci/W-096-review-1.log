   474	const REVIEW_USAGE =
   475	  "usage: bisellium review <opus> --pass|--fail --evidence <path> [--round <n>] [--sella <id>] [--model <id>] [--studio <dir>] [--now <iso>]";
   476	
   477	export function runReview(args: string[], opts: WriteOptions = {}): WriteResult {
   478	  const parsed = parseFlags(args, {
   479	    valued: ["--evidence", "--round", "--sella", "--model", "--studio", "--now"],
   480	    boolean: ["--pass", "--fail"],
   481	  });
