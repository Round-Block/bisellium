   513	function currentDesign(root: string, record: NativeRecord): { digest?: string; error?: string } {
   514	  if (typeof record.title !== "string") return { error: "UI design digest requires a string title" };
   515	  if (typeof record.spec !== "string") return { error: "UI design digest requires a current spec pointer" };
   516	  const brief = readContainedRegularFile(root, record.spec, "briefs");
   517	  if ("error" in brief) return { error: `current brief is unsafe or unreadable: ${brief.error}` };
   518	  return { digest: designDigest(record.title, brief.bytes) };
   519	}
