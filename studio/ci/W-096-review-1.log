   512	    }
   513	  }
   514	
   515	  const now = resolveExactNow(values.get("--now"), opts.now);
   516	  if (!now) {
   517	    console.error("--now must be an ISO date");
   518	    return { exitCode: 2 };
   519	  }
   520	
   521	  const opened = openStudio(values.get("--studio"));
   522	  if ("error" in opened) {
   523	    console.error(opened.error);
   524	    return { exitCode: 2 };
   525	  }
   526	  const { root, manifest } = opened;
   527	
   528	  const opusPath = safeItemPath(join(root, "opera"), opusId);
   529	  if (typeof opusPath !== "string" || !existsSync(opusPath)) {
   530	    console.error(`unknown opus: ${opusId}`);
   531	    return { exitCode: 2 };
   532	  }
   533	
   534	  const unsafeReviewOpus = unsafeOpusProblem(root, opusId);
