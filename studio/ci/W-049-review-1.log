// W-049 round-1 censor mutation driver. Each mutation: exact-string replace
// (must match exactly once), run the three suites, record exit codes and the
// first FAIL names, restore via git checkout. Kept in the review log.
import { readFileSync, writeFileSync } from "node:fs";
import { execFileSync, spawnSync } from "node:child_process";
const wt = process.argv[2];
const E = "packages/shim/src/harness/env.ts", CC = "packages/shim/src/harness/claude-code.ts", CX = "packages/shim/src/harness/codex.ts", T = "packages/commands/src/talk.ts", TB = "packages/cli/src/talk-boundary.test.ts";
const LOOP = "  for (const name of ALLOWLIST) {\n    const value = parent[name];\n    if (value !== undefined) out[name] = value;\n  }";
const byKey = (pred) => `  for (const [k, v] of Object.entries(parent)) if (v !== undefined && (${pred})) out[k] = v;`;
const M = [
  ["M01 list += ANTHROPIC_BASE_URL", [[E, `"no_proxy"])`, `"no_proxy", "ANTHROPIC_BASE_URL"])`]]],
  ["M02 match by startsWith", [[E, LOOP, byKey("ALLOWLIST.some((n) => k.startsWith(n))")]]],
  ["M03 match by unanchored-end regex", [[E, LOOP, byKey(`new RegExp("^(" + ALLOWLIST.join("|") + ")").test(k)`)]]],
  ["M04 case-insensitive compare", [[E, LOOP, byKey("ALLOWLIST.some((n) => n.toLowerCase() === k.toLowerCase())")]]],
  ["M05 re-add LC_/NODE_ pattern", [[E, LOOP, byKey("ALLOWLIST.includes(k) || /^(LC_|NODE_)/.test(k)")]]],
