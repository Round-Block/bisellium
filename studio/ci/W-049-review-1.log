  await phase("runTalk #2", () => runTalk(["--sella", "eng-lead", "--model-only", "--studio", studio, "hello again"]));
  await phase("runTick", () => runTick(["--studio", studio], { now: new Date("2026-09-23T09:00:00Z") }));
} finally { process.env["PATH"] = orig; rmSync(root, { recursive: true, force: true }); }
