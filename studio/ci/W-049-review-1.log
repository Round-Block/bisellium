const stub = `#!/usr/bin/env node
import { appendFileSync } from "node:fs";
const a = process.argv.slice(2); const kind = a.length === 1 && a[0] === "--version" ? "version" : "turn";
appendFileSync(${JSON.stringify(log)}, JSON.stringify({ kind, form: kind === "version" ? "-" : a.includes("--resume") ? "resume" : "start" }) + "\\n");
if (kind === "version") process.exit(0);
process.stdout.write(JSON.stringify({ session_id: "sess-w049", result: "ack", is_error: false }) + "\\n");`;
