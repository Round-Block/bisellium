const read = () => (existsSync(log) ? readFileSync(log, "utf8").trim().split("\n").filter(Boolean).map((l) => JSON.parse(l)) : []);
const phase = async (name: string, f: () => Promise<unknown>) => { const b = read().length; await f(); console.log(name.padEnd(16), JSON.stringify(read().slice(b).map((r: { kind: string; form: string }) => r.kind === "version" ? "version" : `turn:${r.form}`))); };
