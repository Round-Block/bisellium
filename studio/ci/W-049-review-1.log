const W = process.argv[2]!;
const { runTalk } = await import(join(W, "packages/cli/src/talk.ts"));
const { runTick } = await import(join(W, "packages/cli/src/tick.ts"));
const root = mkdtempSync(join(tmpdir(), "w049-probe-"));
const bin = join(root, "bin"); cpSync(join(W, "examples/sample-studio"), join(root, "studio"), { recursive: true });
