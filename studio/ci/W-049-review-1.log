// W-049 round-1 censor: survivors of the three-suite driver, re-run against the FULL `npm test`.
// Each mutation: exact-string edits (each anchor must match exactly once), full suite, restore via git checkout.
import { readFileSync, writeFileSync } from "node:fs";
import { execFileSync, spawnSync } from "node:child_process";
const wt = process.argv[2];
const T = "packages/commands/src/talk.ts";
const PROBE = "isAvailable = await profile.available();";
const START = ": await profile.start({ cwd: root, sella, systemPrompt, message, env });";
const M = [
  ["M13 tick path never resumes (always starts)", [[T, "existing && existing.harness === harnessId", "existing && existing.harness === harnessId && params.modelOnly !== undefined"]]],
  // Partition probe: on the runTalk path only, the FIRST call launches an extra `--version` after its start,
  // and a call with a session file skips its probe. Per-call counts are 3 then 1; the aggregate over the
  // two calls is still 4 and the tick phase is untouched.
  ["M15 per-call count shift across the two runTalk phases (extra launch in call 1, omitted probe in call 2)", [
    [T, PROBE, `isAvailable = params.modelOnly && existsSync(sessionPathFor(root, sella)) ? true : await profile.available();`],
    [T, START, `: await profile.start({ cwd: root, sella, systemPrompt, message, env }).then(async (t) => (params.modelOnly ? await profile.available() : undefined, t));`],
  ]],
];
const only = process.argv[3] ? new Set(process.argv[3].split(",")) : undefined;
for (const [name, edits] of M) {
  if (only && !only.has(name.split(" ")[0])) continue;
  const files = [...new Set(edits.map((e) => e[0]))];
  try {
    for (const [f, from, to] of edits) {
      const p = `${wt}/${f}`, src = readFileSync(p, "utf8");
      const n = src.split(from).length - 1;
      if (n !== 1) throw new Error(`${f}: anchor matched ${n}x`);
      writeFileSync(p, src.replace(from, () => to));
    }
    const r = spawnSync("npm", ["test"], { cwd: wt, encoding: "utf8", timeout: 900_000, maxBuffer: 64 * 1024 * 1024 });
    const out = (r.stdout ?? "") + (r.stderr ?? "");
    const fails = out.split("\n").filter((l) => l.startsWith("FAIL"));
    console.log(`${r.status !== 0 ? "KILLED  " : "SURVIVED"} ${name}  (npm test exit=${r.status}, FAIL=${fails.length}, PASS=${out.split("\n").filter((l) => l.startsWith("PASS")).length})`);
    for (const l of fails.slice(0, 4)) console.log("    " + l.replace(/\s+/g, " ").slice(0, 170));
  } catch (e) {
    console.log(`ERROR    ${name}: ${e.message}`);
  } finally {
    execFileSync("git", ["checkout", "--", ...files], { cwd: wt });
  }
}
