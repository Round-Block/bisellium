    72	const OPUS_BODY_LIMIT_BYTES = 64 * 1024;
    73	const OPUS_FRONT_MATTER_LIMIT_BYTES = 64 * 1024;
    74	const OPUS_BODY_TRUNCATION_MARKER = "\n\n[Record body truncated at 64 KiB.]";
