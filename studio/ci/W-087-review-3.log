    95	 * Read an opus body without `readFront`'s whitespace-wide `.trim()`. Bodies
    96	 * through 64 KiB preserve every authored byte; larger bodies carry a visible
    97	 * truncation marker. A conventional final line ending is file framing and is
    98	 * removed only from an otherwise complete body.
    99	 */
   100	function readOpusBody(studioDir: string, id: string): string {
   101	  const root = resolve(studioDir);
   102	  const dir = join(root, "opera");
   103	  let fd: number | undefined;
   104	  try {
   105	    // Match the established W-084/W-089 non-following read pattern. Every
   106	    // traversed component is lstat'd, the final entry must be a directory-
   107	    // enumerated regular file, and O_NOFOLLOW + fstat close the replacement
   108	    // race at open time. The id is compared with an entry name and is never
   109	    // interpolated into a path, so this server does not duplicate the shared
   110	    // commands safeItemPath helper (which its production graph may not import).
   111	    if (!lstatSync(root).isDirectory() || !lstatSync(dir).isDirectory()) return "";
   112	    const entry = readdirSync(dir, { withFileTypes: true }).find(
   113	      (candidate) => candidate.isFile() && candidate.name.endsWith(".md") && candidate.name.slice(0, -3) === id,
   114	    );
   115	    if (!entry) return "";
   116	    const path = join(dir, entry.name);
   117	    if (!lstatSync(path).isFile()) return "";
   118	    fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW);
   119	    const opened = fstatSync(fd);
   120	    if (!opened.isFile()) return "";
   121	
   122	    const header = Buffer.alloc(Math.min(opened.size, OPUS_FRONT_MATTER_LIMIT_BYTES));
   123	    const headerBytes = readSync(fd, header, 0, header.length, 0);
   124	    const offset = bodyOffset(header.subarray(0, headerBytes));
   125	    if (offset === undefined) return "";
   126	
   127	    const available = Math.max(0, opened.size - offset);
   128	    const bodyBuffer = Buffer.alloc(Math.min(available, OPUS_BODY_LIMIT_BYTES + 2));
   129	    const bytesRead = readSync(fd, bodyBuffer, 0, bodyBuffer.length, offset);
   130	    const bodyBytes = bodyBuffer.subarray(0, bytesRead);
   131	    const onlyFramingLf = available === OPUS_BODY_LIMIT_BYTES + 1 && bodyBytes[OPUS_BODY_LIMIT_BYTES] === 0x0a;
   132	    const onlyFramingCrlf =
   133	      available === OPUS_BODY_LIMIT_BYTES + 2 &&
   134	      bodyBytes[OPUS_BODY_LIMIT_BYTES] === 0x0d &&
   135	      bodyBytes[OPUS_BODY_LIMIT_BYTES + 1] === 0x0a;
   136	    const truncated = available > OPUS_BODY_LIMIT_BYTES && !onlyFramingLf && !onlyFramingCrlf;
   137	    if (truncated) {
   138	      const decoder = new StringDecoder("utf8");
   139	      return decoder.write(bodyBytes.subarray(0, OPUS_BODY_LIMIT_BYTES)) + OPUS_BODY_TRUNCATION_MARKER;
   140	    }
   141	    return bodyBytes.toString("utf8").replace(/\r?\n$/, "");
   142	  } catch {
   143	    return "";
   144	  } finally {
   145	    if (fd !== undefined) {
   146	      try {
   147	        closeSync(fd);
   148	      } catch {
   149	        // The body read has already failed or completed; closing cannot
   150	        // change the honest empty/truncated response selected above.
   151	      }
   152	    }
   153	  }
   154	}
