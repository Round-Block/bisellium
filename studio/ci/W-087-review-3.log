    76	function bodyOffset(raw: Buffer): number | undefined {
    77	  const bomBytes = raw[0] === 0xef && raw[1] === 0xbb && raw[2] === 0xbf ? 3 : 0;
    78	  const lfOpening = Buffer.from("---\n");
    79	  const crlfOpening = Buffer.from("---\r\n");
    80	  let openingLength: number;
    81	  if (raw.subarray(bomBytes, bomBytes + lfOpening.length).equals(lfOpening)) openingLength = lfOpening.length;
    82	  else if (raw.subarray(bomBytes, bomBytes + crlfOpening.length).equals(crlfOpening)) openingLength = crlfOpening.length;
    83	  else return undefined;
    84	
    85	  const searchFrom = bomBytes + openingLength - 1;
    86	  const endings = [Buffer.from("\n---\n"), Buffer.from("\r\n---\r\n")]
    87	    .map((delimiter) => ({ delimiter, index: raw.indexOf(delimiter, searchFrom) }))
    88	    .filter((candidate) => candidate.index !== -1)
    89	    .sort((a, b) => a.index - b.index);
    90	  const ending = endings[0];
    91	  return ending ? ending.index + ending.delimiter.length : undefined;
    92	}
