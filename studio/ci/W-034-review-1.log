    #!/usr/bin/env bash
    # W-034 round-1 censor probes. Run from the 1091a08 scratch tree.
    set -u
    T=$TMPDIR/w034r1; P=$TMPDIR/w034r1-probe/s
    B="node --import tsx $T/packages/cli/src/main.ts"
    fresh() { rm -rf $P; cp -r $T/examples/sample-studio $P; mkdir -p $P/decisions
      dec() { printf -- "---\nid: $1\ntitle: t\nat: 2026-09-24T00:00:00Z\nprovenance: probe\nby: $2\nkill_when: never\n---\nbody\n" > $P/decisions/$1.md; }
      dec D-900 patron; dec D-901 architect
      printf -- "---\nid: D-777\ntitle: t\nat: 2026-09-24T00:00:00Z\nprovenance: probe\nby: patron\nkill_when: never\n---\n" > $P/D-777.md
      printf -- "---\nid: [unclosed\nby: patron\n---\n" > $P/decisions/D-903.md
      printf -- "---\nid: D-904\ntitle: t\nat: x\nprovenance: p\nkill_when: k\n---\n" > $P/decisions/D-904.md
      printf -- "---\nid: D-905\nby: [patron]\n---\n" > $P/decisions/D-905.md
      printf -- "---\n---\nempty front matter\n" > $P/decisions/D-906.md
      printf -- "---\njust a scalar\n---\n" > $P/decisions/D-907.md
      printf -- "---\n- a\n- b\n---\n" > $P/decisions/D-908.md
      printf -- "no front matter at all\n" > $P/decisions/D-909.md
      mkdir -p $P/decisions/D-910.md
      printf -- "---\nnull\n---\n" > $P/decisions/D-911.md
    }
    run() { echo "\$ bisellium $*"; $B "$@" --studio $P 2>&1 | sed "s#$P#<P>#g"; echo "[exit ${PIPESTATUS[0]}]"; }
    sum() { sha1sum $P/opera/W-004.md | cut -c1-12; }
    echo "## A. review bypass: hand-typed review: {status: waived}"
    fresh; sed -i 's#  review: { status: passed, evidence: reviews/W-004.md, certifies: tree:c50a0cef6c7b79d527a88dc8298f446cd5014002 }#  review: { status: waived, reason: x }#' $P/opera/W-004.md
    grep -n "review:" $P/opera/W-004.md | head -1
    echo "-- A1 done alone (check never run):"; before=$(sum); run done W-004; echo "record unchanged: $([ "$before" = "$(sum)" ] && echo yes || echo NO)"
    echo "-- A2 check alone (state review):"; node --import tsx $T/packages/cli/src/main.ts check $P 2>&1 | grep -E "waived|W-004|PASS|FAIL" | sed "s#$P#<P>#g" | head
    echo "-- A3 same record hand-set to state: done (the jump done now refuses):"; sed -i 's/^state: review/state: done/' $P/opera/W-004.md
    node --import tsx $T/packages/cli/src/main.ts check $P 2>&1 | grep -E "W-004|PASS|FAIL" | sed "s#$P#<P>#g" | head
    echo; echo "## B. waive decision probes (patron gate on W-004, state review)"
    for d in ../D-777 D-777 /abs/D-900 D-903 D-904 D-905 D-906 D-907 D-908 D-909 D-910 D-911 D-901 " " D-900.md; do fresh; before=$(sum); run waive W-004 --gate patron --reason r --decision "$d" --sella qa-lead; echo "unchanged: $([ "$before" = "$(sum)" ] && echo yes || echo NO); events: $(ls $P/.bisellium 2>/dev/null | head -1)"; done
    echo; echo "## C. done with hand-typed human waivers pointing at malformed decisions"
    for d in ../D-777 D-906 D-907 D-908 D-909 D-910 D-911; do fresh; sed -i "s#  patron: { status: pending }#  patron: { status: waived, reason: r, waived_by: \"$d\" }#" $P/opera/W-004.md; run done W-004; done
    echo; echo "## D. happy path + permanence"
    fresh; run waive W-004 --gate patron --reason "docs-only" --decision D-900 --sella qa-lead --now 2026-09-24T12:00:00Z
    grep -n "patron" -A5 $P/opera/W-004.md | sed -n 1,7p
    run waive W-004 --gate patron --reason again --decision D-900
    run done W-004; grep -n "^state\|status: waived\|waived_by" $P/opera/W-004.md
    run verify W-004 2>/dev/null | tail -3; grep -c "status: waived" $P/opera/W-004.md
    node --import tsx $T/packages/cli/src/main.ts check $P 2>&1 | grep -E "W-004|PASS|FAIL" | head -5
    echo; echo "## E. multi-gate (behaviour 11 shape) through the CLI"
    fresh; sed -i -e 's#  qa: { status: passed, evidence: qa/W-004.md, certifies: tree:c50a0cef6c7b79d527a88dc8298f446cd5014002 }#  qa: { status: waived, reason: r, waived_by: D-900 }#' -e 's#  patron: { status: pending }#  patron: { status: waived, reason: r, waived_by: D-404 }#' $P/opera/W-004.md
    perl -0pi -e 's/  tests:\n    status: passed/  tests:\n    status: waived\n    reason: r/' $P/opera/W-004.md
    run done W-004
    echo; echo "## F. waive on a scalar / malformed gate node"
    fresh; sed -i 's#  patron: { status: pending }#  patron: pending#' $P/opera/W-004.md; before=$(sum); run waive W-004 --gate patron --reason r --decision D-900 2>&1 | tail -4; echo "unchanged: $([ "$before" = "$(sum)" ] && echo yes || echo NO)"
    fresh; sed -i 's#  patron: { status: pending }#  patron: { status: bogus }#' $P/opera/W-004.md; run waive W-004 --gate patron --reason r --decision D-900

