mut $S "M12 stray token after --strict-mcp-config"           '"--strict-mcp-config",' '"--strict-mcp-config", "WebFetch",'
mut $S "M13 stray token after --restricted"                  '"--restricted",' '"--restricted", "WebFetch",'
mut $S "M14 stray token after --output-format json (start)"  '"json", "--append-system-prompt-file"' '"json", "WebFetch", "--append-system-prompt-file"'
