#!/usr/bin/env bash
# W-044 review 4 mutation runner (same shape as round 3's): one literal substitution,
# run talk-boundary.test.ts, report per-behaviour FAIL counts, restore.
set -u
cd "$TMPDIR/w044r4"
mut() { # file, name, from, to
  local F=$1
  node -e 'const fs=require("fs");const [f,a,b]=process.argv.slice(1);const s=fs.readFileSync(f,"utf8");if(!s.includes(a)){console.error("anchor missing");process.exit(3)}fs.writeFileSync(f,s.replace(a,b))' "$F" "$3" "$4" || return
  out=$(node --import tsx packages/cli/src/talk-boundary.test.ts . 2>&1); rc=$?
  printf '%-58s exit=%s' "$2" "$rc"
  for b in 1 2 3 4; do printf '  b%s FAIL=%s' "$b" "$(grep '^FAIL' <<<"$out" | grep -c "behaviour $b")"; done; echo
  git checkout -q -- "$F"
}
S=packages/shim/src/harness/claude-code.ts
mut $S "M0 none (control)"                                   'const TOOLS = "Read,Grep,Glob,Bash";' 'const TOOLS = "Read,Grep,Glob,Bash";'
# round-3 survivors (F4)
mut $S "M18 resume slot: sessionId -> --allowedTools=Bash"   '"--resume", opts.sessionId,' '"--resume", "--allowedTools=Bash",'
