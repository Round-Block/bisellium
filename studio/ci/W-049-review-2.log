// W-049 round-2 censor mutation driver (round-1 driver, suites narrowed to harness-env.test.ts alone; M15/M16 added). Each mutation: exact-string replace
// (must match exactly once), run the three suites, record exit codes and the
// first FAIL names, restore via git checkout. Kept in the review log.
import { readFileSync, writeFileSync } from "node:fs";
import { execFileSync, spawnSync } from "node:child_process";
const wt = process.argv[2];
const E = "packages/shim/src/harness/env.ts", CC = "packages/shim/src/harness/claude-code.ts", CX = "packages/shim/src/harness/codex.ts", T = "packages/commands/src/talk.ts", TB = "packages/cli/src/talk-boundary.test.ts";
const LOOP = "  for (const name of ALLOWLIST) {\n    const value = parent[name];\n    if (value !== undefined) out[name] = value;\n  }";
const byKey = (pred) => `  for (const [k, v] of Object.entries(parent)) if (v !== undefined && (${pred})) out[k] = v;`;
const M = [
  ["M01 list += ANTHROPIC_BASE_URL", [[E, `"no_proxy"])`, `"no_proxy", "ANTHROPIC_BASE_URL"])`]]],
  ["M02 match by startsWith", [[E, LOOP, byKey("ALLOWLIST.some((n) => k.startsWith(n))")]]],
  ["M03 match by unanchored-end regex", [[E, LOOP, byKey(`new RegExp("^(" + ALLOWLIST.join("|") + ")").test(k)`)]]],
  ["M04 case-insensitive compare", [[E, LOOP, byKey("ALLOWLIST.some((n) => n.toLowerCase() === k.toLowerCase())")]]],
  ["M05 re-add LC_/NODE_ pattern", [[E, LOOP, byKey("ALLOWLIST.includes(k) || /^(LC_|NODE_)/.test(k)")]]],
  ["M06a drop harnessEnv: claude runClaude", [[CC, "env: harnessEnv(opts.env),", "env: opts.env,"]]],
  ["M06b drop harnessEnv: claude available()", [[CC, `{ env: harnessEnv(process.env), encoding`, `{ encoding`]]],
  ["M06c drop harnessEnv: codex runCodex (= codex-only passthrough)", [[CX, "env: harnessEnv(opts.env) }", "env: opts.env }"]]],
  ["M06d drop harnessEnv: codex available()", [[CX, `, { env: harnessEnv(process.env) })`, `)`]]],
  ["M07 scrub by deleting from parent in place", [[E, "  return out;", "  for (const k of Object.keys(parent)) if (!ALLOWLIST.includes(k)) delete parent[k];\n  return parent;"]]],
  ["M08a spawn start twice (claude profile)", [[CC, "      return runClaude(args, { cwd: opts.cwd, env: opts.env, message: opts.message });", "      runClaude(args, { cwd: opts.cwd, env: opts.env, message: opts.message });\n      return runClaude(args, { cwd: opts.cwd, env: opts.env, message: opts.message });"]]],
  ["M08b spawn start twice (performTalk)", [[T, ": await profile.start({ cwd: root, sella, systemPrompt, message, env });", ": (await profile.start({ cwd: root, sella, systemPrompt, message, env }), await profile.start({ cwd: root, sella, systemPrompt, message, env }));"]]],
  ["M08c spawn resume twice (performTalk)", [[T, "? await profile.resume({ cwd: root, sella, sessionId: existing.sessionId, message, env })", "? (await profile.resume({ cwd: root, sella, sessionId: existing.sessionId, message, env }), await profile.resume({ cwd: root, sella, sessionId: existing.sessionId, message, env }))"]]],
  ["M09a skip available() probe in performTalk (always)", [[T, "isAvailable = await profile.available();", "isAvailable = true;"]]],
  ["M09b skip available() probe on tick path only", [[T, "isAvailable = await profile.available();", "isAvailable = params.modelOnly === undefined ? true : await profile.available();"]]],
  ["M09c skip available() probe when a session file exists", [[T, "isAvailable = await profile.available();", `isAvailable = existsSync(join(root, "sessions", sella + ".json")) ? true : await profile.available();`]]],
  ["M10 inject a default for an absent name", [[E, "if (value !== undefined) out[name] = value;", `out[name] = value ?? "";`]]],
  ["M11a W-044 M24: fixed <tmpdir>/system-prompt.md", [[CC, `const file = join(dir, "system-prompt.md");`, `const file = join(tmpdir(), "system-prompt.md");`]]],
  ["M11b W-044 M25: relative x/system-prompt.md in argv", [[CC, `"--append-system-prompt-file", file,`, `"--append-system-prompt-file", "x/system-prompt.md",`]]],
  ["M12a A2: stub replies a random session_id", [[TB, `{ session_id: "sess-stub", result`, `{ session_id: "sess-" + Math.random().toString(36).slice(2), result`]]],
  ["M12b A2: talk resumes an id other than the one returned", [[T, "sessionId: existing.sessionId, message, env })", `sessionId: existing.sessionId + "-x", message, env })`]]],
  ["M13 tick path never resumes (always starts)", [[T, "existing && existing.harness === harnessId", "existing && existing.harness === harnessId && params.modelOnly !== undefined"]]],
  ["M14 tick path resumes sess-w049 for every magister", [[T, "existing && existing.harness === harnessId\n", "(params.modelOnly === undefined || (existing && existing.harness === harnessId))\n"], [T, "sessionId: existing.sessionId, message, env })", `sessionId: existing?.sessionId ?? "sess-w049", message, env })`]]],
  ["M15 per-call count shift across the two runTalk phases", [
    [T, "isAvailable = await profile.available();", `isAvailable = params.modelOnly && existsSync(sessionPathFor(root, sella)) ? true : await profile.available();`],
    [T, ": await profile.start({ cwd: root, sella, systemPrompt, message, env });", `: await profile.start({ cwd: root, sella, systemPrompt, message, env }).then(async (t) => (params.modelOnly ? await profile.available() : undefined, t));`],
  ]],
  ["M16 census inflation: runTalk also writes eng-lead's session as producer's", [[T, "  writeSession(sessPath, {", "  for (const p of params.modelOnly ? [sessPath, sessionPathFor(root, \"producer\")] : [sessPath]) writeSession(p, {"]]],
];
const suites = ["packages/cli/src/harness-env.test.ts"];
const only = process.argv[3] ? new Set(process.argv[3].split(",")) : undefined;
for (const [name, edits] of M) {
  if (only && !only.has(name.split(" ")[0])) continue;
  const files = [...new Set(edits.map((e) => e[0]))];
  try {
    for (const [f, from, to] of edits) {
      const p = `${wt}/${f}`, src = readFileSync(p, "utf8");
      const n = src.split(from).length - 1;
      if (n !== 1) throw new Error(`${f}: anchor matched ${n}x`);
      writeFileSync(p, src.replace(from, () => to));
    }
    const res = suites.map((s) => {
      const r = spawnSync(process.execPath, ["--import", "tsx", s, "."], { cwd: wt, encoding: "utf8", timeout: 240_000 });
      const out = (r.stdout ?? "") + (r.stderr ?? "");
      const fails = out.split("\n").filter((l) => l.startsWith("FAIL")).length;
      const first = out.split("\n").find((l) => l.startsWith("FAIL"))?.replace(/\s+/g, " ").slice(0, 170) ?? (r.status ? out.trim().split("\n").pop()?.slice(0, 170) : "");
      return { s: s.split("/").pop(), exit: r.status, fails, first };
    });
    const killed = res.some((r) => r.exit !== 0);
    console.log(`${killed ? "KILLED  " : "SURVIVED"} ${name}`);
    for (const r of res) console.log(`    ${r.s}: exit=${r.exit} FAIL=${r.fails}${r.first ? `  first: ${r.first}` : ""}`);
  } catch (e) {
    console.log(`ERROR    ${name}: ${e.message}`);
  } finally {
    execFileSync("git", ["checkout", "--", ...files], { cwd: wt });
  }
}
console.log("clean:", execFileSync("git", ["status", "--porcelain"], { cwd: wt, encoding: "utf8" }).trim() === "" ? "yes" : "NO");
