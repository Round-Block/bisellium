// W-049 round-2: M16 applied, phase probe + FULL npm test, restore via git checkout.
import { readFileSync, writeFileSync } from "node:fs";
import { execFileSync, spawnSync } from "node:child_process";
const wt = process.argv[2], T = "packages/commands/src/talk.ts", p = `${wt}/${T}`;
const src = readFileSync(p, "utf8"), from = "  writeSession(sessPath, {";
if (src.split(from).length !== 2) throw new Error("anchor");
writeFileSync(p, src.replace(from, () => '  for (const p of params.modelOnly ? [sessPath, sessionPathFor(root, "producer")] : [sessPath]) writeSession(p, {'));
try {
  console.log(execFileSync("git", ["--no-pager", "diff", "--stat"], { cwd: wt, encoding: "utf8" }).trim());
  const pr = spawnSync(process.execPath, ["--import", "tsx", "w049-probe-phases.mts", wt], { cwd: wt, encoding: "utf8" });
  console.log("probe exit=" + pr.status + "\n" + pr.stdout + pr.stderr);
  const r = spawnSync("npm", ["test"], { cwd: wt, encoding: "utf8", timeout: 900_000, maxBuffer: 64 * 1024 * 1024 });
  const out = (r.stdout ?? "") + (r.stderr ?? "");
  const fails = out.split("\n").filter((l) => l.startsWith("FAIL"));
  console.log(`${r.status !== 0 ? "KILLED  " : "SURVIVED"} M16 full npm test exit=${r.status} FAIL=${fails.length} PASS=${out.split("\n").filter((l) => l.startsWith("PASS")).length}`);
  for (const l of fails.slice(0, 4)) console.log("    " + l.replace(/\s+/g, " ").slice(0, 200));
} finally {
  execFileSync("git", ["checkout", "--", T], { cwd: wt });
}
