   261	function summarizeEvent(e: EventRow): string {
   262	  const a = e.attrs;
   263	  switch (e.name) {
   264	    case "workflow.item_appeared":
   265	      return "appeared";
   266	    case "workflow.state_changed":
   267	      return `state ${String(a["workflow.state.from"] ?? "?")} → ${String(a["workflow.state.to"] ?? "?")}`;
   268	    case "workflow.gate_evaluated":
   269	      return `gate ${String(a["workflow.gate.id"] ?? "?")} ${String(a["workflow.gate.status"] ?? "?")}`;
   270	    case "workflow.actor_assigned":
   271	      return `assigned ${String(a["workflow.actor.role"] ?? "?")}`;
   272	    case "workflow.item_removed":
   273	      return "removed";
   274	    case "workflow.attention":
   275	      return `attention ${String(a["workflow.attention.event"] ?? "")}`.trim();
   276	    case "gen_ai.usage":
   277	      return `usage by ${String(a["workflow.actor.role"] ?? "?")}`;
   278	    default:
   279	      return e.name;
   280	  }
   281	}
