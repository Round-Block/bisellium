   166	      if (refetchTimer.current) clearTimeout(refetchTimer.current);
   167	      unsubscribe();
   168	    };
   169	    // Mount-once: every handler above reads current state through refs.
   170	  }, []);
   171	
   172	  // ---- Removal / column-change while the drawer is open: close it, and
   173	  // restore focus to the nearest remaining card in that column, or the
   174	  // column head if it's now empty. Never document.body. ---------------------
   175	  useEffect(() => {
   176	    const sel = selected;
   177	    if (!sel) return;
