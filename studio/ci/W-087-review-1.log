    85	    pendingCloseRestorationRef.current = undefined;
    86	
    87	    const scrollEl = document.querySelector<HTMLElement>(".board__columns");
    88	    if (scrollEl && pending.scrollLeft !== undefined) scrollEl.scrollLeft = pending.scrollLeft;
    89	
    90	    const { selection, fallback } = pending;
    91	    const columnEl = document.querySelector<HTMLElement>(`.board__columns [data-column-id="${selection.columnId}"]`);
    92	    if (!fallback) {
