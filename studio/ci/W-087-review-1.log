    52	
    53	/** Minimal, strict flag parser shared by all five commands: any `--flag`
    54	 *  not declared in `spec` is a usage error, never a silent no-op — this is
    55	 *  what makes budget refuse an arbitrary `--burn-anything` flag. */
    56	export function parseFlags(args: string[], spec: FlagSpec): ParsedFlags | { error: string } {
    57	  const valued = new Set(spec.valued ?? []);
    58	  const boolean = new Set(spec.boolean ?? []);
    59	  const values = new Map<string, string>();
    60	  const flags = new Set<string>();
    61	  const positionals: string[] = [];
    62	  for (let i = 0; i < args.length; i++) {
    63	    const a = args[i]!;
    64	    if (a.startsWith("--")) {
    65	      if (boolean.has(a)) {
    66	        flags.add(a);
    67	        continue;
    68	      }
    69	      if (valued.has(a)) {
    70	        const v = args[++i];
    71	        if (v === undefined) return { error: `${a} needs a value` };
    72	        values.set(a, v);
    73	        continue;
    74	      }
    75	      return { error: `unknown flag "${a}"` };
    76	    }
    77	    positionals.push(a);
    78	  }
    79	  return { values, flags, positionals };
    80	}
