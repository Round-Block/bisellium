    97	    if (firstCard) {
    98	      firstCard.focus({ preventScroll: true });
    99	      return;
   100	    }
   101	    columnEl?.querySelector<HTMLElement>(".board__column-head")?.focus({ preventScroll: true });
   102	  }, [selected]);
   103	
   104	  function markRefreshed(): void {
   105	    setLastRefreshAt(new Date().toISOString());
   106	  }
   107	
   108	  async function fetchDrawerEvents(id: string): Promise<void> {
   109	    const rows = await fetchEvents({ item: id });
   110	    setEventsByItem((prev) => ({ ...prev, [id]: rows }));
   111	  }
   112	
   113	  async function fetchBoardOnly(): Promise<void> {
   114	    const [o, ops, ib] = await Promise.all([fetchOfficina(), fetchOpera(), fetchInbox()]);
   115	    setOfficina(o);
   116	    setOpera(ops);
   117	    setInbox(ib);
   118	    setEverLoaded(true);
   119	    markRefreshed();
   120	  }
   121	
   122	  // Driven by reconcileTargets' own output — not a hand-rolled duplicate of
   123	  // its list — so the brief's claim ("Reconciliation fetches exactly
   124	  // reconcileTargets(selected)") is literally true, and the one place that
   125	  // list lives is lib/board.ts's own already-pinned export (behaviour 3).
   126	  async function fullReconcile(selectedId: string | undefined): Promise<void> {
   127	    const tasks = reconcileTargets(selectedId).map((target) => {
   128	      if (target === "/api/officina") return fetchOfficina().then(setOfficina);
   129	      if (target === "/api/opera") return fetchOpera().then(setOpera);
   130	      if (target === "/api/inbox") return fetchInbox().then(setInbox);
   131	      return fetchDrawerEvents(selectedId!);
   132	    });
   133	    await Promise.all(tasks);
   134	    setEverLoaded(true);
   135	    markRefreshed();
   136	  }
