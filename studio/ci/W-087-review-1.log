    68	function Column({
    69	  column,
    70	  selectedId,
    71	  focusedByColumn,
    72	  onSelectCard,
    73	}: {
    74	  column: BoardModel["columns"][number];
    75	  selectedId?: string;
    76	  focusedByColumn: Record<string, string | undefined>;
    77	  onSelectCard: (id: string, columnId: string) => void;
    78	}): JSX.Element {
    79	  const focusedId = focusedByColumn[column.id] ?? column.cards[0]?.id;
    80	  const classes = ["board__column", column.pinned && "board__column--pinned"].filter(Boolean).join(" ");
    81	  return (
    82	    <div className={classes} data-column-id={column.id}>
    83	      <div className="board__column-head" tabIndex={-1}>
    84	        <span className="board__column-name">{column.name}</span>
    85	        <span className="board__column-count">{column.cards.length}</span>
    86	      </div>
    87	      {column.cap !== undefined && (
    88	        <div className="board__wip-rule">
