   151	        connRef.current = { connected: true, everFetched: true };
   152	        setConnected(true);
   153	        if (reason) void fullReconcile(selectedRef.current?.id);
   154	      },
   155	      onError: () => {
   156	        connRef.current = { connected: false, everFetched: connRef.current.everFetched };
   157	        setConnected(false);
   158	      },
   159	      onEvent: (e) => {
