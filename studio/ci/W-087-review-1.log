   138	  function scheduleBoardRefetch(): void {
   139	    if (refetchTimer.current) clearTimeout(refetchTimer.current);
   140	    refetchTimer.current = setTimeout(() => {
   141	      refetchTimer.current = undefined;
   142	      void fetchBoardOnly();
   143	    }, REFETCH_DEBOUNCE_MS);
   144	  }
   145	
   146	  // ---- SSE: connect/reconnect reconciliation + frame-driven refetch -------
   147	  useEffect(() => {
   148	    const unsubscribe = subscribeLive({
   149	      onOpen: () => {
