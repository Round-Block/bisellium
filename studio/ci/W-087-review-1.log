   104	export function safeItemPath(dir: string, id: string): string | { error: string } {
   105	  if (!id || /[\\/]/.test(id) || id === "." || id === "..") return { error: `invalid id "${id}"` };
   106	  const resolvedDir = resolve(dir);
   107	  const path = join(resolvedDir, `${id}.md`);
   108	  if (dirname(path) !== resolvedDir) return { error: `invalid id "${id}"` };
   109	  return path;
   110	}
