   240	/**
   241	 * Seam S1 (W-089): the single authority on what a sella id means against a
   242	 * manifest's `sellae` roster. Every membership test and row lookup goes
   243	 * through this — no caller re-implements `id.split(".")` or `sellae.find`.
   244	 *
   245	 * An exact declared id (a live template or a `retired: true` tombstone)
   246	 * resolves with `instance` absent; exact match is tried first. Otherwise the
   247	 * substring before the FIRST "." is taken as the seat id and the (non-empty)
   248	 * remainder as `instance` — the seat itself is matched whole, never split on
   249	 * "-", so a hyphenated seat id (`builder-codex`) still parses
   250	 * `builder-codex.W-100` correctly. `ghost`, `ghost.W-089`, `builder.` (empty
   251	 * instance) and any other prefix that names nothing declared all return
   252	 * `undefined`.
   253	 *
   254	 * A retired row still resolves — reads must work forever. Resolution is NOT
   255	 * permission to dispatch: the caller reads `resolved.seat.retired` and
   256	 * applies its own live/historical policy (behaviour 6).
   257	 */
   258	export function resolveSeat<T extends SeatLike>(manifest: { sellae?: readonly T[] }, id: string): ResolvedSeat<T> | undefined {
   259	  if (!id) return undefined;
   260	  const rows = manifest.sellae ?? [];
   261	  const exact = rows.find((r) => r.id === id);
   262	  if (exact) return { seat: exact };
   263	
   264	  const dot = id.indexOf(".");
   265	  if (dot <= 0) return undefined; // no "." at all, or an empty seat prefix
   266	  const instance = id.slice(dot + 1);
   267	  if (instance.length === 0) return undefined; // "builder." — empty instance
   268	  const seat = rows.find((r) => r.id === id.slice(0, dot));
   269	  if (!seat) return undefined;
   270	  return { seat, instance };
   271	}
