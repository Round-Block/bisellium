    43	/**
    44	 * A `bisellium serve` instance this test can KILL and RESTART on the exact
    45	 * same port and studio dir — `harness.ts` (not owned by this opus) has no
    46	 * such capability, and there is no other reliable way in this environment to
    47	 * sever an already-open `/api/live` connection: `browserContext.setOffline`
    48	 * was measured (empirically, against a real served instance) to have NO
    49	 * effect on an established loopback SSE stream — no `onError`/reconnect ever
    50	 * fires, even held offline for 16s (spanning a heartbeat). Killing the
    51	 * process is a real TCP reset the browser's `EventSource` genuinely notices
    52	 * (confirmed: the liveness label flips to "disconnected" within one poll of
    53	 * the kill, and to "live" again within ~1s of the restart) — this is what
    54	 * actually exercises the reconnect path recorded in the brief's *Liveness*
    55	 * section, rather than a no-op that happened to pass anyway.
    56	 */
    57	interface RestartableServed {
    58	  port: number;
    59	  token: string;
    60	  studioDir: string;
    61	  baseURL: string;
    62	  kill: () => void;
    63	  restart: () => Promise<void>;
    64	  close: () => Promise<void>;
    65	}
    66	
    67	async function startRestartable(tag: string): Promise<RestartableServed> {
    68	  const studioDir = mkdtempSync(join(tmpdir(), `bisellium-w064r-${tag}-`));
    69	  cpSync(SAMPLE_STUDIO, studioDir, { recursive: true });
    70	
    71	  let child: ChildProcessWithoutNullStreams;
    72	  let port: number | undefined;
    73	  let token: string | undefined;
    74	
    75	  async function spawnAndWaitReady(fixedPort: number): Promise<void> {
    76	    child = spawn(process.execPath, ["--import", "tsx", MAIN_TS, "serve", "--studio", studioDir, "--port", String(fixedPort)], { cwd: REPO_ROOT, stdio: ["ignore", "pipe", "pipe"] });
    77	    let stdout = "";
    78	    await new Promise<void>((resolvePromise, reject) => {
    79	      const timer = setTimeout(() => reject(new Error(`bisellium serve never printed its port/token within 15s:\n${stdout}`)), 15_000);
    80	      child.stdout.on("data", (chunk: Buffer) => {
    81	        stdout += chunk.toString("utf8");
    82	        const portMatch = /listening on http:\/\/127\.0\.0\.1:(\d+)/.exec(stdout);
    83	        const tokenMatch = /write-auth token \(X-Bisellium-Token\): (\S+)/.exec(stdout);
    84	        if (portMatch) port = Number(portMatch[1]);
    85	        if (tokenMatch) token = tokenMatch[1];
    86	        if (port !== undefined && token !== undefined) {
    87	          clearTimeout(timer);
    88	          resolvePromise();
    89	        }
    90	      });
    91	      child.on("error", (e) => {
    92	        clearTimeout(timer);
    93	        reject(e);
    94	      });
    95	      child.on("exit", (code) => {
    96	        if (port === undefined || token === undefined) {
    97	          clearTimeout(timer);
    98	          reject(new Error(`bisellium serve exited (${code}) before printing port/token:\n${stdout}`));
    99	        }
   100	      });
   101	    });
   102	    const base = `http://127.0.0.1:${port}`;
   103	    const start = Date.now();
   104	    while (Date.now() - start < 10_000) {
   105	      try {
   106	        if ((await fetch(`${base}/api/officina`)).status === 200) return;
   107	      } catch {
   108	        // not up yet
   109	      }
   110	      await new Promise((r) => setTimeout(r, 100));
   580	    await page.locator('.board__card').first().click();
   581	    const drawerBox = await page.locator(".board-drawer").boundingBox();
   582	    expect(Math.abs((drawerBox?.width ?? 0) - viewportWidth)).toBeLessThanOrEqual(1);
   583	    const closeBox = await page.locator(".board-drawer__close").boundingBox();
   584	    expect(closeBox?.width).toBeGreaterThanOrEqual(44);
   585	    expect(closeBox?.height).toBeGreaterThanOrEqual(44);
   586	    expect(closeBox && closeBox.y >= 0 && closeBox.y < 844).toBe(true);
   587	
   588	    await page.goto(`${served.baseURL}/#/inbox`);
   589	    expect(counter.count()).toBe(0);
   590	  });
   591	
