    13	
    14	export function BoardDrawer({ detail, onClose }: BoardDrawerProps): JSX.Element | null {
    15	  if (!detail) return null;
    16	
    17	  return (
    18	    <div className="board-drawer" role="dialog" aria-label={detail.title}>
