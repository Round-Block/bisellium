   190	function setTraditioNext(studioDir: string, id: string, value: string): void {
   191	  const path = join(studioDir, "opera", `${id}.md`);
   192	  const raw = readFileSync(path, "utf8");
   193	  const changed = raw.replace(/next: [^,}]*/, `next: "${value}"`);
   194	  if (changed === raw) throw new Error(`${id} has no inline traditio.next`);
   195	  writeFileSync(path, changed, "utf8");
