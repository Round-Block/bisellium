   116	export function BoardView({ studio, model, selectedId, focusedByColumn, onSelectCard, liveness, generatedAt }: BoardViewProps): JSX.Element {
   117	  return (
   118	    <div className="board">
   119	      <div className="board__header">
   120	        <h1 className="board__title">Board</h1>
   121	        <div className="board__project-select-wrap">
   122	          <select className="board__project-select" disabled aria-label="project" value={studio} onChange={() => undefined}>
   123	            <option value={studio}>{studio}</option>
   124	          </select>
   125	          <span className="board__project-select-reason">{UNAVAILABLE_REASON}</span>
   126	        </div>
   127	      </div>
   128	      <div className="board__strip">
   129	        {model.columns.map((column) => (
   130	          <button key={column.id} type="button" className="board__strip-item" onClick={() => scrollColumnIntoView(column.id)}>
   131	            {column.name} <span className="board__strip-count">{column.cards.length}</span>
   132	          </button>
   133	        ))}
   134	      </div>
   135	      <div className="board__columns">
   136	        {model.columns.map((column) => (
   137	          <Column key={column.id} column={column} selectedId={selectedId} focusedByColumn={focusedByColumn} onSelectCard={onSelectCard} />
   138	        ))}
   139	      </div>
   140	      {liveness !== undefined && <div className="board__liveness">{liveness}</div>}
   141	      <Colophon studioPath={studio} generatedAt={generatedAt} />
   142	    </div>
   143	  );
   144	}
     1	/**
     2	 * apps/web/src/screens/BoardDrawer.tsx — W-064: the detail drawer,
