   182	function setOpusBody(studioDir: string, id: string, body: string): void {
   183	  const path = join(studioDir, "opera", `${id}.md`);
   184	  const raw = readFileSync(path, "utf8");
   185	  const closing = raw.indexOf("\n---\n", 4);
   186	  if (closing < 0) throw new Error(`${id} has no closing front-matter delimiter`);
   187	  writeFileSync(path, `${raw.slice(0, closing + 5)}${body}\n`, "utf8");
   188	}
