   256	        e.preventDefault();
   257	        closeDrawer();
   258	        return;
   259	      }
   260	      const active = document.activeElement as HTMLElement | null;
   261	      if (!active || !active.hasAttribute("data-card-id")) return;
   262	      const columnId = active.getAttribute("data-column-id");
   263	      const cardId = active.getAttribute("data-card-id");
   264	      if (!columnId || !cardId) return;
   265	      const col = modelRef.current.columns.find((c) => c.id === columnId);
   266	      if (!col) return;
   267	
   268	      if (e.key === "j" || e.key === "ArrowDown" || e.key === "k" || e.key === "ArrowUp") {
   269	        const ids = col.cards.map((c) => c.id);
   270	        const idx = ids.indexOf(cardId);
   271	        const next = e.key === "j" || e.key === "ArrowDown" ? Math.min(ids.length - 1, idx + 1) : Math.max(0, idx - 1);
