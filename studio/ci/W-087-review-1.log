    63	  const modelRef = useRef(model);
    64	  const connRef = useRef<{ connected: boolean; everFetched: boolean }>({ connected: false, everFetched: false });
    65	  const refetchTimer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
    66	  const scrollSnapshotRef = useRef<number | undefined>(undefined);
    67	  const pendingCloseRestorationRef = useRef<PendingCloseRestoration | undefined>(undefined);
    68	  const pendingFocusRef = useRef<{ columnId: string; cardId: string } | undefined>(undefined);
    69	
    70	  useEffect(() => {
    71	    selectedRef.current = selected;
    72	  }, [selected]);
    73	  useEffect(() => {
    74	    modelRef.current = model;
    75	  }, [model]);
    76	
    77	  // Restore only after React has committed the closed layout. Scheduling this
