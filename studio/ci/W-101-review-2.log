   336	
   337	function functionName(node: ts.Node): string {
   338	  let current: ts.Node | undefined = node.parent;
   339	  while (current) {
   340	    if (ts.isFunctionDeclaration(current) && current.name) return current.name.text;
   341	    current = current.parent;
   342	  }
   343	  return "<module>";
   344	}
   345	
   346	function idSeamCalls(rel: string): string[] {
   347	  const path = join(repo, ...rel.split("/"));
   348	  const source = ts.createSourceFile(path, readFileSync(path, "utf8"), ts.ScriptTarget.Latest, true);
   349	  const direct = new Set<string>();
   350	  const namespaces = new Set<string>();
   351	  for (const statement of source.statements) {
   352	    if (!ts.isImportDeclaration(statement) || !ts.isStringLiteral(statement.moduleSpecifier)) continue;
   353	    if (statement.moduleSpecifier.text !== "@bisellium/commands/ids.js") continue;
   354	    const bindings = statement.importClause?.namedBindings;
   355	    if (bindings && ts.isNamedImports(bindings)) {
   356	      for (const specifier of bindings.elements) {
   357	        if ((specifier.propertyName ?? specifier.name).text === "createNextRecord") direct.add(specifier.name.text);
   358	      }
   359	    } else if (bindings && ts.isNamespaceImport(bindings)) namespaces.add(bindings.name.text);
   360	  }
   361	  const calls: string[] = [];
   362	  function visit(node: ts.Node): void {
   363	    if (ts.isCallExpression(node)) {
   364	      const expression = node.expression;
   365	      const matches =
   366	        (ts.isIdentifier(expression) && direct.has(expression.text)) ||
   367	        (ts.isPropertyAccessExpression(expression) &&
   368	          expression.name.text === "createNextRecord" &&
   369	          ts.isIdentifier(expression.expression) &&
   370	          namespaces.has(expression.expression.text));
   371	      if (matches) calls.push(`${rel}:${functionName(node)}`);
   372	    }
   373	    ts.forEachChild(node, visit);
   374	  }
   375	  visit(source);
   376	  return calls;
   377	}
