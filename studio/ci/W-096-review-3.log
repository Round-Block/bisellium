   674	interface RulingResult {
   675	  valid: boolean;
   676	  current: boolean;
   677	  problem?: string;
   678	}
   679	
   680	function ruling(root: string, record: NativeRecord, decisionId: string, digest: string, inputAt?: string, servedAt?: string, servedTree?: string): RulingResult {
   681	  if (!DECISION_ID.test(decisionId)) return { valid: false, current: false, problem: `${decisionId} is not a decision id` };
   682	  const file = readContainedRegularFile(root, `decisions/${decisionId}.md`, "decisions");
   683	  if ("error" in file) return { valid: false, current: false, problem: `${decisionId} is unsafe or unreadable: ${file.error}` };
   684	  const split = splitFront(file.bytes.toString("utf8"));
   685	  if (!split) return { valid: false, current: false, problem: `${decisionId} has no front matter` };
   686	  const doc = parseDocument(split.front, { uniqueKeys: true });
   687	  if (doc.errors.length || !isMap(doc.contents)) return { valid: false, current: false, problem: `${decisionId} has malformed or duplicate-key front matter` };
   688	  const scalar = (key: string): string | undefined => {
   689	    const node = doc.get(key, true);
   690	    return isScalar(node) && typeof node.value === "string" ? node.value : undefined;
   691	  };
   692	  const values = {
   693	    id: scalar("id"), by: scalar("by"), provenance: scalar("provenance"), title: scalar("title"), kill_when: scalar("kill_when"),
   694	    opus: scalar("opus"), certifies: scalar("certifies"), design_digest: scalar("design_digest"), at: scalar("at"),
   695	  };
   696	  if (values.id !== decisionId || values.by !== "patron" || values.provenance !== "stated" || !values.title?.trim() || !values.kill_when?.trim() || values.opus !== record.id || !values.certifies || !TREE_CERTIFICATE.test(values.certifies) || !values.design_digest || !DIGEST.test(values.design_digest) || !values.at || utcTimestampProblem(values.at) || split.body.trim() === "")
   697	    return { valid: false, current: false, problem: `${decisionId} is not a structured Patron UI ruling for this opus` };
   698	  const current =
   699	    inputAt !== undefined &&
   700	    servedAt !== undefined &&
   701	    servedTree !== undefined &&
   702	    values.certifies === servedTree &&
   703	    values.design_digest === digest &&
   704	    instant(values.at) >= Math.max(instant(inputAt), instant(servedAt));
   705	  return { valid: true, current };
   706	}
