   708	export function validateUiPolicy(context: UiPolicyContext): OpusModelProblem[] {
   709	  const { root, record, manifest, phase } = context;
   710	  if (record.kind !== "ui") return [];
   711	  const problems: OpusModelProblem[] = [];
   712	  const state = typeof record.state === "string" ? record.state : "";
   713	  const needsInput = phase === "ready" || phase === "done" || ["building", "verifying", "review", "done"].includes(state) || (state === "halted" && record.start !== undefined);
   714	  const id = typeof record.id === "string" ? record.id : "";
   715	  let hasInputCandidate = false;
   716	  try {
   717	    const pattern = new RegExp(`^${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}-spec-[1-9][0-9]*\\.log$`);
   718	    hasInputCandidate = readdirSync(join(root, "ci")).some((name) => pattern.test(name));
   719	  } catch { /* an early-state record does not require ci/ to exist */ }
   720	  const recordedGates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes)
   721	    ? (record.probationes as Record<string, unknown>)
   722	    : {};
   723	  const reviewId = typeof manifest.review_probatio === "string" && manifest.review_probatio.length > 0 ? manifest.review_probatio : "review";
   724	  const censor = censorSella(manifest);
   725	  const reviewGate = typeof recordedGates[reviewId] === "object" && recordedGates[reviewId] !== null && !Array.isArray(recordedGates[reviewId])
   726	    ? (recordedGates[reviewId] as Record<string, unknown>)
   727	    : {};
   728	  const validateDesign = needsInput || hasInputCandidate || record.ui_rulings !== undefined || reviewGate["status"] === "passed";
   729	  const needsRoute = needsInput || hasInputCandidate;
   730	  const uiSeat = manifest.sellae.find((seat) => seat.id === "ui-lead");
   731	  if (needsRoute && (!uiSeat || uiSeat.retired === true || uiSeat.collegium !== "design"))
   732	    problems.push({ rule: "opus.ui.route", message: "ui-lead must be a live design-collegium seat" });
   733	  problems.push(...effectiveProbationes("ui", manifest.probationes).problems);
   734	  const design = validateDesign ? currentDesign(root, record) : {};
   735	  let input: ReturnType<typeof authoritativeUiInput> = { problems: [] };
   736	  if (validateDesign && !design.digest) {
   737	    problems.push({ rule: "opus.ui.design", message: design.error ?? "current design could not be read" });
   738	  } else if (design.digest) input = authoritativeUiInput(root, record, design.digest);
   739	  const addPolicyProblem = (rule: "opus.ui.design" | "opus.ui.e2e" | "opus.ui.rulings", message: string): void => {
   740	    if (/unsafe|unreadable|symlink|regular file/i.test(message)) problems.push({ rule: "opus.reference", message });
   741	    problems.push({ rule, message });
   742	  };
   743	  if (needsInput || input.input || input.problems.some((problem) => !problem.startsWith("no ui-lead")))
   744	    for (const message of input.problems) addPolicyProblem("opus.ui.design", message);
   745	  const served = validateServed(root, record);
   746	  const needsServed = phase === "review" || phase === "done" || state === "review" || state === "done";
   747	  if (needsServed) for (const message of served.problems) addPolicyProblem("opus.ui.e2e", message);
   748	  if ((phase === "done" || state === "done" || reviewGate["status"] === "passed") && input.input && design.digest)
   749	    for (const message of reviewCitation(root, record, input.input, design.digest, reviewId, censor)) addPolicyProblem("opus.ui.design", message);
   750	
