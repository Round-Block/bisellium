    21	const TIMEOUT_MS = 30_000;
    22	
    23	export function normalizeExclude(dir: string): string {
    24	  let d = dir.replaceAll("\\", "/");
    25	  if (d.startsWith("./")) d = d.slice(2);
    26	  let end = d.length;
    27	  while (end > 0 && d.charCodeAt(end - 1) === 47 /* "/" */) end -= 1;
    28	  return d.slice(0, end);
    29	}
    30	
    31	function isUnderExcluded(path: string, excludes: string[]): boolean {
    32	  const p = path.replace(/^"|"$/g, "").replace(/\\/g, "/");
    33	  return excludes.some((ex) => ex.length > 0 && (p === ex || p.startsWith(`${ex}/`)));
    34	}
