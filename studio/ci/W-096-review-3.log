   531	export function validateRecordReferences(root: string, record: NativeRecord): OpusModelProblem[] {
   532	  // A non-UI done opus is historical: no lifecycle policy reads its current
   533	  // brief again, just as the legacy active-spec rule does not revisit it.
   534	  // UI is different because done policy recomputes the design digest from
   535	  // the current brief, so that reference remains live and must stay bounded.
   536	  if (record.state === "done" && record.kind !== "ui") return [];
   537	  if (record.spec === undefined) return [];
   538	  if (typeof record.spec !== "string") return [{ rule: "opus.reference", message: "spec must be a contained brief path" }];
   539	  const brief = readContainedRegularFile(root, record.spec, "briefs");
   540	  return "error" in brief ? [{ rule: "opus.reference", message: `spec is unsafe or unreadable: ${brief.error}` }] : [];
   541	}
