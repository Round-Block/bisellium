   317	function checkW096ProtectedRecords(root: string, opts: RuleOpts): Finding[] {
   318	  const record = safeFront(root, join(root, "opera", "W-096.md"));
   319	  if (!record) return [];
   320	  const unverifiable = (message: string): Finding[] => [{
   321	    rule: "opus.records_unchanged",
   322	    level: "block",
   323	    where: "opera/W-096.md",
   324	    message: `preservation is unverifiable: ${message}`,
   325	  }];
   326	  if (!opts.repo) return unverifiable("repository context (--repo) is absent");
