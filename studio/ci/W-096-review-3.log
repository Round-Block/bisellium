   643	function reviewCitation(
   644	  root: string,
   645	  record: NativeRecord,
   646	  input: UiInput,
   647	  expectedDigest: string,
   648	  reviewId: string,
   649	  censor: string | undefined,
   650	): string[] {
   651	  const gates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes) ? (record.probationes as Record<string, unknown>) : {};
   652	  const review = gates[reviewId];
   653	  if (typeof review !== "object" || review === null || Array.isArray(review)) return ["passed UI review evidence is missing"];
   654	  const gate = review as Record<string, unknown>;
   655	  if (gate["status"] !== "passed") return ["UI completion needs the sole review gate passed"];
   656	  const evidence = typeof gate["evidence"] === "string" ? gate["evidence"] : "";
   657	  const file = readContainedRegularFile(root, evidence, "ci");
   658	  if ("error" in file) return [`review evidence is unsafe or unreadable: ${file.error}`];
   659	  const header = parseVerdictHeader(file.bytes.toString("utf8"));
   660	  const problems: string[] = [];
   661	  if (!censor) problems.push("review gate cannot identify the manifest QA magister censor");
   662	  else if (gate["sella"] !== censor) problems.push(`review gate sella must be the censor ${censor}`);
   663	  if (header.duplicates.length) problems.push("review evidence contains duplicate header keys");
   664	  if (censor && header.values.get("sella") !== censor) problems.push(`review evidence header sella must be the censor ${censor}`);
   665	  if (header.values.get("ui_input") !== input.relative) problems.push("review evidence does not cite the current ui-lead input");
   666	  if (header.values.get("design_digest") !== expectedDigest) problems.push("review evidence design_digest is missing or stale");
   667	  const sections = contentLines(header.body);
   668	  const dispositionHeads = sections.headings.filter((heading) => heading.level === 2 && heading.name === "UI input disposition");
   669	  const disposition = sections.lines.filter((line) => line.section === "UI input disposition");
   670	  if (dispositionHeads.length !== 1 || disposition.length === 0) problems.push("review evidence needs one nonblank ## UI input disposition section");
   671	  return problems;
   672	}
