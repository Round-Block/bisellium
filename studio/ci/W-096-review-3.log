   874	      const working = readContainedRegularFile(repo, path, path.split("/")[0]!);
   875	      if ("error" in working) problems.push(`${path}: working-tree entry is unsafe or unreadable: ${working.error}`);
   876	      else {
   877	        const mode = working.mode & 0o111 ? "100755" : "100644";
   878	        if (mode !== match[1]) problems.push(`${path}: working-tree mode differs from baseline`);
   879	        if (!baselineBytes.equals(working.bytes)) problems.push(`${path}: working-tree bytes differ from baseline`);
   880	      }
   881	    }
   882	    protectedPaths.sort();
   883	    return { ok: problems.length === 0, baseline, protectedPaths, problems };
   884	  } catch (error) {
   885	    problems.push(`preservation is unverifiable: ${(error as Error).message}`);
   886	    return { ok: false, protectedPaths, problems };
   887	  }
   888	}
