    38	 * — exactly what git prints, one line per entry, already path-sorted),
    39	 * excluding any path under one of `excludeDirs` (repo-root-relative, e.g.
    40	 * the studio dir and `.bisellium`). Deterministic for a given commit +
    41	 * exclusion set, and unaffected by anything that only touches an excluded
    42	 * path.
    43	 */
    44	export function sourceTreeHash(repo: string, excludeDirs: string[], ref = "HEAD"): string {
    45	  const excludes = excludeDirs.map(normalizeExclude).filter((d) => d.length > 0);
    46	  const out = execFileSync("git", ["ls-tree", "-r", ref], { cwd: repo, encoding: "utf8", timeout: TIMEOUT_MS });
    47	  const hash = createHash("sha1");
    48	  for (const line of out.split("\n")) {
    49	    if (line.length === 0) continue;
    50	    const tab = line.indexOf("\t");
    51	    const path = tab === -1 ? "" : line.slice(tab + 1);
    52	    if (isUnderExcluded(path, excludes)) continue;
    53	    hash.update(line);
    54	    hash.update("\n");
    55	  }
    56	  return hash.digest("hex");
    57	}
    58	
    59	/**
    60	 * True when `git status --porcelain` in `repo` reports a change OUTSIDE
    61	 * every path in `excludeDirs` (repo-root-relative). A rename/copy line's
    62	 * "old -> new" is split into both paths — either one being outside an
    63	 * exclusion counts.
    64	 */
    65	export function isDirtyOutside(repo: string, excludeDirs: string[]): boolean {
    66	  const excludes = excludeDirs.map(normalizeExclude).filter((d) => d.length > 0);
    67	  const out = execFileSync("git", ["status", "--porcelain"], { cwd: repo, encoding: "utf8", timeout: TIMEOUT_MS });
    68	  const lines = out.split("\n").filter((l) => l.length > 0);
    69	  return lines.some((line) => {
