   551	function currentDesign(root: string, record: NativeRecord): { digest?: string; error?: string } {
   552	  if (typeof record.title !== "string") return { error: "UI design digest requires a string title" };
   553	  if (typeof record.spec !== "string") return { error: "UI design digest requires a current spec pointer" };
   554	  const brief = readContainedRegularFile(root, record.spec, "briefs");
   555	  if ("error" in brief) return { error: `current brief is unsafe or unreadable: ${brief.error}` };
   556	  return { digest: designDigest(record.title, brief.bytes) };
   557	}
