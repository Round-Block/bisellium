   617	function validateServed(root: string, record: NativeRecord): { at?: string; tree?: string; problems: string[] } {
   618	  const gates = typeof record.probationes === "object" && record.probationes !== null && !Array.isArray(record.probationes) ? (record.probationes as Record<string, unknown>) : {};
   619	  const value = gates["served-e2e"];
   620	  if (typeof value !== "object" || value === null || Array.isArray(value)) return { problems: ["served-e2e has no recorded result"] };
   621	  const gate = value as Record<string, unknown>;
   622	  const problems: string[] = [];
   623	  if (gate["status"] !== "passed") problems.push("served-e2e must be passed and cannot be waived");
   624	  const certifies = typeof gate["certifies"] === "string" ? gate["certifies"] : undefined;
   625	  if (!certifies || !TREE_CERTIFICATE.test(certifies)) problems.push("served-e2e needs a clean tree certificate");
   626	  const at = typeof gate["at"] === "string" ? gate["at"] : undefined;
   627	  if (!at || utcTimestampProblem(at)) problems.push("served-e2e needs an exact run timestamp");
   628	  const evidence = typeof gate["evidence"] === "string" ? gate["evidence"] : undefined;
   629	  if (!evidence) problems.push("served-e2e needs an evidence log");
   630	  else {
   631	    const log = readContainedRegularFile(root, evidence, "ci");
   632	    if ("error" in log) problems.push(`served-e2e evidence is unsafe or unreadable: ${log.error}`);
   633	    else {
   634	      const text = log.bytes.toString("utf8");
   635	      if (!certifies || !text.includes(`certifies: ${certifies}`)) problems.push("served-e2e evidence does not corroborate its certificate");
   636	      if (!text.includes("command: node scripts/served-e2e.mjs")) problems.push("served-e2e evidence does not corroborate the reserved command");
   637	      if (!/^exit code: 0\s*$/m.test(text)) problems.push("served-e2e evidence does not record a successful run");
   638	    }
   639	  }
   640	  return { at, tree: certifies, problems };
   641	}
