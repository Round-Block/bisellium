   328	  try {
   329	    const repoReal = realpathSync(resolve(opts.repo));
   330	    const studioReal = realpathSync(resolve(root));
   331	    if (relative(repoReal, studioReal).split(sep).join("/") !== "studio")
   332	      return unverifiable("selected studio is not the native studio inside the supplied repository");
   333	  } catch {
   334	    return unverifiable("repository or studio identity cannot be resolved");
   335	  }
