   474	function hasPlaceholder(text: string): boolean {
   475	  const folded = fullCaseFold(text.trim());
   476	  if (PLACEHOLDERS.has(folded)) return true;
   477	  const boundary = "[^\\p{L}\\p{M}\\p{N}]";
   478	  return new RegExp(
   479	    `(?:^|${boundary})(?:tbd|todo|pending|placeholder|n\\s*\\/\\s*a|\\.\\.\\.|insert\\s+findings|insert\\s+recommendation)(?=$|${boundary})`,
   480	    "u",
   481	  ).test(folded);
   482	}
