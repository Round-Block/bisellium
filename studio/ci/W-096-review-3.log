   559	function authoritativeUiInput(root: string, record: NativeRecord, expectedDigest: string): { input?: UiInput; problems: string[] } {
   560	  const id = typeof record.id === "string" ? record.id : "";
   561	  const candidates: { relative: string; round: number }[] = [];
   562	  let names: string[] = [];
   563	  try {
   564	    names = readdirSync(join(root, "ci"));
   565	  } catch {
   566	    return { problems: ["ci/ is unreadable; no ui-lead input can be established"] };
   567	  }
   568	  const pattern = new RegExp(`^${id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}-spec-([1-9][0-9]*)\\.log$`);
   569	  for (const name of names) {
   570	    const match = pattern.exec(name);
   571	    if (!match) continue;
   572	    candidates.push({ relative: `ci/${name}`, round: Number(match[1]) });
   573	  }
   574	  if (candidates.length === 0) return { problems: ["no ui-lead spec input exists"] };
   575	  candidates.sort((a, b) => b.round - a.round);
   576	  const latest = candidates[0]!;
   577	  const file = readContainedRegularFile(root, latest.relative, "ci");
   578	  if ("error" in file) return { problems: [`latest UI spec round is unsafe or unreadable: ${file.error}`] };
   579	  const h = parseVerdictHeader(file.bytes.toString("utf8"));
   580	  const problems: string[] = [];
   581	  if (h.duplicates.length) problems.push(`duplicate verdict header key(s): ${h.duplicates.join(", ")}`);
   582	  if (h.values.get("opus") !== id || h.values.get("phase") !== "spec" || h.values.get("round") !== String(latest.round) || h.values.get("sella") !== "ui-lead")
   583	    problems.push("latest ui-lead verdict header does not match its opus, phase, round and sella");
   584	  const outcome = h.values.get("outcome") ?? "";
   585	  const at = h.values.get("at") ?? "";
   586	  if (utcTimestampProblem(at)) problems.push("latest ui-lead verdict has an invalid timestamp");
   587	  const digest = h.values.get("design_digest") ?? "";
   588	  if (!DIGEST.test(digest) || digest !== expectedDigest) problems.push("latest ui-lead verdict has a missing, malformed or stale design_digest");
   589	  const promptRel = h.values.get("dispatch_prompt");
   590	  if (!promptRel) problems.push("latest ui-lead verdict has no dispatch_prompt header");
   591	  let prompt: string | undefined;
   592	  if (promptRel) {
   593	    const file = readContainedRegularFile(root, promptRel, "ci");
   594	    if ("error" in file) problems.push(`dispatch prompt is unsafe or unreadable: ${file.error}`);
   595	    else prompt = file.bytes.toString("utf8");
   596	  }
   597	  problems.push(...substantiveUiTranscript(h.body, outcome, prompt));
   598	  if (problems.length) return { problems };
   599	  return { input: { relative: latest.relative, header: h, round: latest.round, at, digest }, problems };
   600	}
