   412	const PLACEHOLDERS = new Set(["tbd", "todo", "pending", "placeholder", "n/a", "...", "insert findings", "insert recommendation"]);
   413	
   414	function contentLines(markdown: string): { headings: { level: number; name: string; line: number }[]; lines: { text: string; section?: string }[] } {
   415	  const headings: { level: number; name: string; line: number }[] = [];
   416	  const lines: { text: string; section?: string }[] = [];
   417	  let fence: string | undefined;
   418	  let comment = false;
   419	  let section: string | undefined;
   420	  const sourceLines = markdown.split(/\r?\n/);
   421	  for (let index = 0; index < sourceLines.length; index++) {
   422	    const raw = sourceLines[index]!;
   423	    const trimmed = raw.trim();
   424	    const fenceMatch = /^(`{3,}|~{3,})(.*)$/.exec(trimmed);
   425	    if (fenceMatch) {
   426	      if (!fence) fence = fenceMatch[1];
   427	      else {
   428	        const close = new RegExp(`^${fence[0] === "`" ? "`" : "~"}{${fence.length},}\\s*$`);
   429	        if (close.test(trimmed)) fence = undefined;
   430	      }
   431	      continue;
   432	    }
   433	    if (fence) continue;
   434	    let line = raw;
   435	    if (comment) {
   436	      const end = line.indexOf("-->");
   437	      if (end === -1) continue;
   438	      line = line.slice(end + 3);
   439	      comment = false;
   440	    }
   441	    while (line.includes("<!--")) {
   442	      const start = line.indexOf("<!--");
   443	      const end = line.indexOf("-->", start + 4);
   444	      if (end === -1) {
   445	        line = line.slice(0, start);
   446	        comment = true;
   447	        break;
   448	      }
   449	      line = line.slice(0, start) + line.slice(end + 3);
   450	    }
   451	    const next = sourceLines[index + 1];
   452	    const setext = next === undefined ? undefined : /^\s{0,3}(=+|-+)\s*$/.exec(next);
   453	    if (line.trim() !== "" && setext) {
   454	      const level = setext[1]![0] === "=" ? 1 : 2;
   455	      const name = line.trim();
   456	      headings.push({ level, name, line: index });
   457	      section = level === 2 ? name : undefined;
   458	      index++;
   459	      continue;
   460	    }
   461	    const heading = /^(#{1,6})\s+(.+?)\s*$/.exec(line.trim());
   462	    if (heading) {
   463	      const name = heading[2]!.trim();
   464	      const level = heading[1]!.length;
   465	      headings.push({ level, name, line: index });
   466	      if (level <= 2) section = level === 2 ? name : undefined;
   467	      continue;
   468	    }
   469	    if (line.trim() !== "") lines.push({ text: line.trim(), section });
   470	  }
   471	  return { headings, lines };
   472	}
