## Mutation script (kept: /tmp/claude-1000/w044r1-ev/mutate.sh)
#!/usr/bin/env bash
# W-044 review 1 mutation runner: apply one literal substitution to claude-code.ts,
# run talk-boundary.test.ts, report per-behaviour FAIL counts, restore.
set -u
cd /tmp/claude-1000/w044r1
F=packages/shim/src/harness/claude-code.ts
mut() { # name, from, to
  node -e 'const fs=require("fs");const [f,a,b]=process.argv.slice(1);const s=fs.readFileSync(f,"utf8");if(!s.includes(a)){console.error("anchor missing");process.exit(3)}fs.writeFileSync(f,s.replace(a,b))' "$F" "$2" "$3" || return
  out=$(node --import tsx packages/cli/src/talk-boundary.test.ts . 2>&1); rc=$?
  printf '%-44s exit=%s' "$1" "$rc"
  for b in 1 2 3 4; do printf '  b%s FAIL=%s' "$b" "$(grep '^FAIL' <<<"$out" | grep -c "behaviour $b")"; done; echo
  git checkout -q -- "$F"
}
mut "M0 none (control)"                     'const TOOLS = "Read,Grep,Glob,Bash";' 'const TOOLS = "Read,Grep,Glob,Bash";'
mut "M1 re-add Bash(bisellium *) to allowlist" '"Bash(bisellium check *)",' '"Bash(bisellium check *)", "Bash(bisellium *)",'
mut "M2 WebFetch back in --tools"            'const TOOLS = "Read,Grep,Glob,Bash";' 'const TOOLS = "Read,Grep,Glob,Bash,WebFetch";'
mut "M3 WebFetch back in --allowedTools"     '  "Glob",' '  "Glob", "WebFetch",'
mut "M4 drop --restricted"                   '"--restricted", ' ''
mut "M5 resume: dup --allowedTools Bash(bisellium *)" '"json", ...POLICY_FLAGS];' '"json", ...POLICY_FLAGS, "--allowedTools", "Bash(bisellium *)"];'
mut "M6 start+resume: POLICY + dup --allowedTools" '"--allowedTools", ...ALLOWED_TOOLS];' '"--allowedTools", ...ALLOWED_TOOLS, "--allowedTools", "Bash(bisellium *)"];'
mut "M7 POLICY + dup --tools WebFetch"       '"--allowedTools", ...ALLOWED_TOOLS];' '"--allowedTools", ...ALLOWED_TOOLS, "--tools", "WebFetch"];'
mut "M8 POLICY + dup --permission-mode acceptEdits" '"--allowedTools", ...ALLOWED_TOOLS];' '"--allowedTools", ...ALLOWED_TOOLS, "--permission-mode", "acceptEdits"];'
mut "M9 comma-joined extra allow entry"      '"Bash(bisellium check *)",' '"Bash(bisellium check *)", "Glob,Bash(bisellium *)",'
git status --short
