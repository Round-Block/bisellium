### slot-probe.mjs
// W-044 review 3: what does the vendor CLI do when a variable slot (resume session id,
// start system-prompt file) carries a flag-shaped token? Captures system/init or the
// exit, kills on init. ANTHROPIC_* stripped and base URL pointed at a dead localhost
// port, so no request can leave the machine and no credential is sent anywhere.
import { spawn } from "node:child_process";
import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
const ALLOWED = ["Read","Grep","Glob","Bash(bisellium)","Bash(bisellium context)","Bash(bisellium context *)","Bash(bisellium query)","Bash(bisellium query *)","Bash(bisellium check)","Bash(bisellium check *)"];
const TAIL = ["--restricted","--strict-mcp-config","--permission-mode","dontAsk","--tools","Read,Grep,Glob,Bash","--allowedTools",...ALLOWED];
const variants = {
  start_baseline: ["-p","--output-format","stream-json","--verbose",...TAIL],
  M19_start_slot_allowedTools_eq: ["-p","--output-format","stream-json","--verbose","--append-system-prompt-file","--allowedTools=Bash",...TAIL],
  resume_bogus_id: ["-p","--resume","00000000-0000-0000-0000-000000000000","--output-format","stream-json","--verbose",...TAIL],
  M18_resume_slot_allowedTools_eq: ["-p","--resume","--allowedTools=Bash","--output-format","stream-json","--verbose",...TAIL],
  M21_resume_slot_tools_eq: ["-p","--resume","--tools=WebFetch","--output-format","stream-json","--verbose",...TAIL],
};
const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith("ANTHROPIC_")));
env.ANTHROPIC_BASE_URL = "http://127.0.0.1:9";
const cwd = mkdtempSync(join(tmpdir(), "w044r3-slot-"));
for (const [label, argv] of Object.entries(variants)) {
  const r = await new Promise((res) => {
    const c = spawn("claude", argv, { cwd, env, stdio: ["pipe","pipe","pipe"] });
    let buf = "", err = "", done = false;
    const finish = (v) => { if (!done) { done = true; c.kill("SIGKILL"); res(v); } };
    c.stdout.on("data", (d) => { buf += d; for (const l of buf.split("\n")) { try { const j = JSON.parse(l); if (j.type === "system" && j.subtype === "init") finish({ init: j }); } catch {} } });
    c.stderr.on("data", (d) => (err += d));
    c.on("exit", (code) => finish({ exit: code, stderr: err.slice(0, 300), stdout: buf.slice(0, 300) }));
    c.stdin.end("say ok");
    setTimeout(() => finish({ timeout: true }), 60000);
  });
  const s = r.init ? `permissionMode=${r.init.permissionMode} tools=${JSON.stringify(r.init.tools)} session=${r.init.session_id}` : JSON.stringify(r);
  console.log(`${label.padEnd(34)} ${s}`);
}
