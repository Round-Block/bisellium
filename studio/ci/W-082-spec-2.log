export interface WriteOptions {
  /** Pinned clock, for reproducible timestamps/events in tests — same
   *  shape as run.ts's RunOptions.now. Overridden by an explicit --now. */
  now?: Date;
}

export interface WriteResult {
  exitCode: number;
