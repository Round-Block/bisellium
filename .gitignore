node_modules/
dist/
*.tsbuildinfo
.env
.bisellium/
# Playwright's own run artifacts (W-029) — regenerated on every
# `npm run test:e2e`, not something to commit.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
# Receipts are local liveness evidence (bisellium run), not something to
# commit — unlike ci/*.log, which opera link to as evidence and stay tracked.
studio/receipts/
**/receipts/
# health.json is `bisellium tick`'s generated snapshot (W-011) — regenerated
# on every tick, not something to commit. Daily acta evidence links to
# bisellium.yml instead, precisely so it's never a dead link in a clone.
**/health.json
# models.json is `bisellium probe`'s generated evidence record (W-069) —
# regenerated by the next battery, not something to commit; same reasoning
# as health.json above.
**/models.json
# The pause/resume marker (W-011) — local operator state, not studio content.
**/PAUSED
# Talk sessions and timelines (W-010) — local conversation state, not
# something to commit: like receipts/, they're liveness/chatter, not the
# studio's committed record (a petitio or a decision escalates out of one).
studio/sessions/
**/sessions/
studio/timeline/
**/timeline/
# events.jsonl (W-012 `bisellium emit`, and @bisellium/core's snapshot-diff
# ingestion) is derived/local workflow telemetry, not the studio's
# committed record — same reasoning as receipts/ and sessions/ above.
studio/events.jsonl
**/events.jsonl
# Claude Code's own local overrides (W-017) — .claude/settings.json is the
# committed hook/agent/command profile; settings.local.json is a per-machine
# override (e.g. a developer's own permission grants) and never shared.
.claude/settings.local.json
# Per-builder git worktrees the Claude Code Workflow harness creates inside
# the repo (cascade-5 review, W-016/W-019 advisory) — local checkout state,
# not studio content; an untracked worktree here made `verify` see a dirty
# tree and mint `dirty:` certificates for byte-identical tracked source.
.claude/worktrees/
# Claude Code's Bash sandbox (bubblewrap) masks these cwd paths with
# /dev/null device nodes so a command cannot plant shell/tool config in the
# working tree. From inside the sandbox they read as untracked files, which
# would make every `verify` see a dirty tree — same failure class as
# .claude/worktrees/ above. Outside the sandbox none of them exist.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.mcp.json
.idea
.vscode
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/skills
.claude/workflows
.claude/.claude/
